{
  "project_name": "ic_thermal_test",
  "environment": {
    "koomeshmodifier_path": "/opt/SmartTwinPreprocessor/bin/KooMeshModifier",
    "lsdyna_path": "/opt/ls-dyna/lsdyna_R16.1.1",
    "mpi_path": "mpirun",
    "memory": "2G",
    "lsdyna_memory": "4000m",
    "apptainer_sif": "/opt/apptainers/SmartTwinPreprocessor.sif",
    "apptainer_bind": "/data:/data",
    "apptainer_env": {},
    "lsdyna_apptainer_sif": "/opt/apptainers/LSDynaBasic_aocc420_ompi4.0.5_mpp_d.sif",
    "lsdyna_apptainer_bind": "/data:/data",
    "lsdyna_apptainer_env": {
      "LSTC_FILE": "/opt/ls-dyna_license/LSTC_FILE",
      "LSTC_LICENSE_SERVER": "192.168.122.1",
      "FI_PROVIDER": "tcp",
      "I_MPI_FABRICS": "ofi",
      "LD_LIBRARY_PATH": "/opt/openmpi/lib"
    },
    "apptainer_tmpdir": "/data/tmp",
    "nodes_per_job": 1,
    "mpi_launcher": "mpirun",
    "mpi_enabled": true,
    "ncpu": 1,
    "koochainrun_path": "/data/SmartTwinPreprocessor/bin/KooChainRun",
    "time_limit": "04:00:00"
  },
  "simulation_params": {
    "dt": 1e-06,
    "thermal": {
      "thermal_type": "ICPower",
      "analysis_type": "transient",
      "unit_system": "SI",
      "initial_temperature_C": 25,
      "timestep": { "its": 1.0, "tmax": 20.0, "dtemp": 5.0 },
      "default_cte_1_K": 1.7e-5,
      "materials": {
        "1": { "rho": 2330, "hc": 700, "tc": 150, "cte": 2.6e-6 },
        "2": { "rho": 1850, "hc": 1100, "tc": 0.3, "cte": 14e-6 },
        "3": { "rho": 2700, "hc": 896, "tc": 167, "cte": 23.6e-6 }
      },
      "heat_sources": [
        { "part": 1, "power_W": 3.0, "volume_mm3": 100.0 }
      ]
    }
  },
  "scenarios": [
    {
      "scenario_name": "IC_Thermal_Stress",
      "template": "MinimumModel.k",
      "thermal_conditions": ["HOT_3W"],
      "cumulative": { "num_steps": 1, "mode_sequence": ["THERM"] }
    }
  ]
}
