        elif r["cancel_result"] == "error":
            print(f"  DOE {doe_idx:3d}: 취소 실패 - {r.get('error', '')}")

    print()
    print(f"취소: {cancelled}개 / 이미 종료: {already}개 / 실패: {errors}개")


def _rerun_sequential(manager, target_does, exclude_list, args):
    """남은 DOE를 노드에 분배하여 sequential 배치 잡으로 재제출"""
    import json
    import subprocess
    import tempfile
    from datetime import datetime

    runner_config = manager.load_runner_config()
    env = runner_config.get("environment", {})
    project_name = runner_config["project"]["name"]
    output_dir = runner_config["project"]["output_dir"]
    doe_count = runner_config["scenario"]["doe_count"]

    kcr_path = env.get("koochainrun_path", "KooChainRun")
    apptainer_tmpdir = env.get("apptainer_tmpdir")
    apptainer_tmpdir_line = f"export APPTAINER_TMPDIR={apptainer_tmpdir}" if apptainer_tmpdir else "# APPTAINER_TMPDIR not configured"

    partition = env.get("partition", "normal")
    ncpu = env.get("ncpu", 16)
    memory = env.get("memory", "64G")
    time_limit = env.get("time_limit", "24:00:00")
    # rerun 도 submit 과 동일하게 step 수·DR 배율 반영
    _sdf = _step_dr_time_factor(runner_config)
    if _sdf > 1:
        time_limit = _hms_scale(time_limit, _sdf)
    exclusive = env.get("exclusive", True)

    # 노드 수 결정
    num_nodes = args.nodes
    if num_nodes is None:
        # 자동 감지: 해당 파티션의 idle 노드 수
        try:
            result = subprocess.run(
                ["sinfo", "-p", partition, "-h", "-t", "idle,mix", "-o", "%N"],
                capture_output=True, text=True, timeout=10
            )
            if result.returncode == 0 and result.stdout.strip():
                # 노드 리스트 파싱 (예: "node[001-004]" → 4)
                try:
                    node_out = subprocess.run(
                        ["scontrol", "show", "hostnames", result.stdout.strip()],
                        capture_output=True, text=True, timeout=10
                    )
                    if node_out.returncode == 0:
                        nodes_avail = [n for n in node_out.stdout.strip().split("\n") if n]
                        if exclude_list:
                            nodes_avail = [n for n in nodes_avail if n not in exclude_list]
                        num_nodes = len(nodes_avail)
                except (subprocess.TimeoutExpired, FileNotFoundError):
                    pass
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass
        if not num_nodes or num_nodes < 1:
            num_nodes = 1
        print(f"  자동 감지된 노드 수: {num_nodes}")

    if num_nodes > len(target_does):
        num_nodes = len(target_does)

    print(f"Sequential rerun: {len(target_does)} DOE를 {num_nodes}개 노드에 분배")

    # target_does를 노드에 round-robin 분배
    node_doe_map = {n: [] for n in range(num_nodes)}
    for i, doe_idx in enumerate(sorted(target_does)):
        node_doe_map[i % num_nodes].append(doe_idx)

    for node_idx, doe_list in node_doe_map.items():
        print(f"  Slot {node_idx}: {len(doe_list)} DOEs (DOE {doe_list[0]}~{doe_list[-1]})")

    # time_limit: DOE 수에 비례 확장
    max_does_per_node = max(len(v) for v in node_doe_map.values())

    def _multiply_tl(tl_str, multiplier):
        parts = tl_str.split(":")
        total_sec = int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
        total_sec *= multiplier
        h = int(total_sec // 3600)
        m = int((total_sec % 3600) // 60)
        s = int(total_sec % 60)
        return f"{h}:{m:02d}:{s:02d}"

    seq_time_limit = _multiply_tl(time_limit, max_does_per_node)

    # 파티션 최대 cap
    try:
        part_info = subprocess.run(
            ["sinfo", "-p", partition, "-h", "-o", "%l"],
            capture_output=True, text=True, timeout=5
        )
        if part_info.returncode == 0 and part_info.stdout.strip():
            partition_max = part_info.stdout.strip().split("\n")[0].strip()
            if partition_max.upper() != "UNLIMITED":
                pm_parts = partition_max.split("-")
                if len(pm_parts) == 2:
                    pm_sec = int(pm_parts[0]) * 86400
                    hms = pm_parts[1].split(":")
                else:
                    pm_sec = 0
                    hms = pm_parts[0].split(":")
                pm_sec += int(hms[0]) * 3600 + int(hms[1]) * 60 + int(hms[2])

                stl_parts = seq_time_limit.split(":")
                stl_sec = int(stl_parts[0]) * 3600 + int(stl_parts[1]) * 60 + int(stl_parts[2])

                if stl_sec > pm_sec:
                    seq_time_limit = partition_max
                    print(f"  Time limit cap: {partition_max}")
    except Exception:
        pass

    # exclude_line 생성
    exclude_line = ""
    if exclude_list:
        exclude_line = f"#SBATCH --exclude={','.join(exclude_list)}"
    exclusive_line = "#SBATCH --exclusive" if exclusive else ""
    seq_mem = "0" if exclusive else memory

    # runner_config 경로 찾기
    test_dir = Path(args.test_dir).resolve()
    config_candidates = [test_dir / "runner_config.json"]
    config_path = None
    for c in config_candidates:
        if c.exists():
            config_path = str(c)
            break
    if config_path is None:
        print(f"  ERROR: runner_config.json not found in {test_dir}")
        return

    slurm_dir = Path(output_dir) / "slurm_scripts"
    slurm_dir.mkdir(parents=True, exist_ok=True)

    # jobs.json 로드
    jobs_file = test_dir / "jobs.json"
    if jobs_file.exists():
        try:
            with open(jobs_file, 'r', encoding='utf-8') as f:
                jobs_data = json.load(f)
        except (json.JSONDecodeError, OSError):
            jobs_data = {"project_name": project_name, "jobs": {}}
    else:
        jobs_data = {"project_name": project_name, "jobs": {}}
    jobs_data.setdefault("jobs", {})

    # 각 슬롯 스크립트 생성 + 제출
    rerun_count = int(datetime.now().strftime("%H%M%S"))
    submitted_jobs = 0
    for node_idx in range(num_nodes):
        doe_list = node_doe_map[node_idx]
        if not doe_list:
            continue

        job_name = f"{project_name}_RSEQ{node_idx:03d}"
        script_path = slurm_dir / f"rerun_seq_{rerun_count}_{node_idx:03d}.sh"
        log_path = slurm_dir / f"rerun_seq_{rerun_count}_{node_idx:03d}_%j.log"

        header = f"""#!/bin/bash
#SBATCH --job-name={job_name}
#SBATCH --partition={partition}
#SBATCH --nodes=1
#SBATCH --ntasks={ncpu}
#SBATCH --cpus-per-task=1
#SBATCH --mem={seq_mem}
#SBATCH --time={seq_time_limit}
#SBATCH --output={log_path}
#SBATCH --error={log_path}
#SBATCH --chdir=/data
#SBATCH --requeue
{exclusive_line}
{exclude_line}
"""

        doe_cmds = ""
        for doe_idx in doe_list:
            doe_cmds += f"""
echo "========================================"
echo "DOE {doe_idx}/{doe_count} (rerun slot {node_idx})"
echo "Start: $(date)"
echo "========================================"
{kcr_path} run {config_path} --doe {doe_idx}
DOE_EXIT=$?
if [ $DOE_EXIT -ne 0 ]; then
    echo "DOE {doe_idx} failed (exit=$DOE_EXIT), continuing..."
    pkill -u $(whoami) -f "squashfuse.*apptainer" 2>/dev/null || true
    sleep 3
fi
echo "DOE {doe_idx} exit code: $DOE_EXIT"
echo ""
"""

        script_content = header + f"""{apptainer_tmpdir_line}

echo "========================================"
echo "Rerun Sequential Job: {job_name}"
echo "Node: $(hostname)"
echo "DOEs: {len(doe_list)}ea"
echo "Start: $(date)"
echo "========================================"

HEALTH_CHECK_DIR={output_dir}/.node_health_$$
if ! mkdir -p "$HEALTH_CHECK_DIR" 2>/dev/null; then
    echo "ERROR: output dir not writable: {output_dir}"
    exit 1
fi
rmdir "$HEALTH_CHECK_DIR" 2>/dev/null

pkill -u $(whoami) -f "squashfuse.*apptainer" 2>/dev/null || true
find {output_dir} -name "*.lock" -mmin +10 -delete 2>/dev/null || true

# 시작 지연: 슬롯별 분산 (NFS burst 방지)
STAGGER=$((RANDOM % 60 + {node_idx * 10}))
echo "시작 지연: ${{STAGGER}}초 (슬롯 {node_idx})"
sleep $STAGGER

{doe_cmds}

echo "========================================"
echo "Rerun Sequential Done: $(date)"
echo "========================================"
"""
        try:
            with open(script_path, 'w', encoding='utf-8') as f:
                f.write(script_content)
            os.chmod(str(script_path), 0o755)
        except OSError as e:
            print(f"  Slot {node_idx}: 스크립트 생성 실패: {e}")
            continue

        try:
            result = subprocess.run(
                ["sbatch", str(script_path)],
                capture_output=True, text=True, timeout=30
            )
            if result.returncode == 0:
                job_id = result.stdout.strip().split()[-1]
                print(f"  Slot {node_idx:2d}: submitted (job {job_id}) — {len(doe_list)} DOEs")
                for doe_idx in doe_list:
                    jobs_data["jobs"][str(doe_idx)] = {
                        "job_id": job_id,
                        "job_name": job_name,
                        "status": "resubmitted",
                        "submitted_at": datetime.now().isoformat(),
                        "script_path": str(script_path),
                        "sequential_slot": node_idx,
                        "rerun": True
                    }
                submitted_jobs += 1
            else:
                print(f"  Slot {node_idx:2d}: FAILED - {result.stderr.strip()}")
        except (subprocess.TimeoutExpired, FileNotFoundError) as e:
            print(f"  Slot {node_idx:2d}: FAILED - {e}")

    # jobs.json 저장 (atomic write: tmpfile → rename)
    try:
        fd, tmp_path = tempfile.mkstemp(dir=str(test_dir), suffix=".tmp")
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(jobs_data, f, indent=2, ensure_ascii=False)
        os.replace(tmp_path, str(jobs_file))
    except OSError as e:
        print(f"  경고: jobs.json 저장 실패: {e}")
        if 'tmp_path' in locals() and os.path.exists(tmp_path):
            os.unlink(tmp_path)

    print(f"\n재제출 완료: {submitted_jobs}개 슬롯 / {len(target_does)} DOEs")
    if exclude_list:
        print(f"제외 노드: {exclude_list}")


def cmd_rerun(args):
    """실패/미완료 DOE만 재실행"""
    import json
    import subprocess
    from Runner.JobManager import JobManager

    test_dir = Path(args.test_dir).resolve()
    manager = JobManager(str(test_dir))

    print("=" * 80)
    print("KooChainRun - DOE 상태 확인")
    print("=" * 80)

    try:
        status_map = manager.get_doe_status()
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"[ERROR] JSON 파일 손상으로 상태 확인 불가: {e}")
        print("  손상된 JSON 파일을 수동으로 확인하거나 삭제 후 재시도하세요.")
        sys.exit(1)

    # 상태 테이블 출력
    print()
    print(f"  {'DOE':>5}  {'상태':<15} {'Slurm':<12} {'Step':>8}")
    print("  " + "-" * 45)
    corrupted_does = []
    for doe_idx in sorted(status_map.keys()):
        info = status_map[doe_idx]
        step_str = f"{info['steps_completed']}/{info['steps_total']}"
        status_label = info['status']
        if info.get("json_corrupted"):
            status_label = "json_corrupted"
            corrupted_does.append(doe_idx)
        print(f"  {doe_idx:>5}  {status_label:<15} {info['slurm_state']:<12} {step_str:>8}")

    # 재실행 대상 결정 (json_corrupted DOE는 제외)
    if args.does:
        target_does = [int(d.strip()) for d in args.does.split(",")]
    else:
        target_does = [
            doe_idx for doe_idx, info in status_map.items()
            if info["status"] in ("failed", "killed", "not_started", "license_error")
            and not info.get("json_corrupted")
        ]

    completed = sum(1 for info in status_map.values() if info["status"] == "completed")
    print()
    print(f"완료: {completed}/{len(status_map)}개")

    if corrupted_does:
        print(f"[WARNING] JSON 손상 DOE (재실행 제외): {corrupted_does}")
        print("  해당 DOE의 simulation_index/checkpoint 파일을 확인하세요.")

    if not target_does:
        print("재실행 대상 DOE가 없습니다.")
        return

    print(f"재실행 대상: {len(target_does)}개 - DOE {target_does}")

    # 실패 노드 제외 처리
    exclude_nodes_arg = getattr(args, 'exclude_nodes', None)
    exclude_nodes = set()

    if exclude_nodes_arg == "auto":
        # sacct에서 FAILED/NODE_FAIL 잡의 노드 자동 감지
        print("\n실패 노드 자동 감지 중...")
        try:
            failed_job_ids = []
            for doe_idx, info in status_map.items():
                jid = info.get("job_id")
                if jid and info["status"] in ("failed", "killed", "not_started"):
                    # CANCELLED는 사용자가 직접 취소한 것 — 노드 문제 아님, 제외
                    slurm_st = info.get("slurm_state", "")
                    if slurm_st == "CANCELLED":
                        continue
                    failed_job_ids.append(str(jid))
            if failed_job_ids:
                sacct_result = subprocess.run(
                    ["sacct", "-j", ",".join(failed_job_ids),
                     "--format=NodeList", "--noheader", "--parsable2"],
                    capture_output=True, text=True, timeout=30
                )
                if sacct_result.returncode == 0:
                    for line in sacct_result.stdout.strip().split("\n"):
                        node = line.strip()
                        if node and node != "None assigned":
                            exclude_nodes.add(node)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print("  sacct 실행 불가 — 노드 자동 감지 생략")

        # Slurm down/drain 노드도 추가
        try:
            sinfo_result = subprocess.run(
                ["sinfo", "-N", "-h", "-t", "down,drain,drng", "-o", "%N"],
                capture_output=True, text=True, timeout=10
            )
            if sinfo_result.returncode == 0:
                for line in sinfo_result.stdout.strip().split("\n"):
                    node = line.strip()
                    if node:
                        exclude_nodes.add(node)
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass

        if exclude_nodes:
            print(f"  제외 노드: {sorted(exclude_nodes)}")
        else:
            print("  제외할 노드 없음")

    elif exclude_nodes_arg:
        exclude_nodes = set(n.strip() for n in exclude_nodes_arg.split(","))
        print(f"\n수동 제외 노드: {sorted(exclude_nodes)}")

    if args.dry_run:
        print("\n[DRY-RUN] 실제 제출하지 않습니다.")
        return

    if not args.force:
        try:
            if getattr(args, 'sequential', False):
                reply = input(f"\n{len(target_does)}개 DOE를 sequential 모드로 재제출하시겠습니까? (y/n): ")
            else:
                reply = input(f"\n{len(target_does)}개 DOE를 재제출하시겠습니까? (y/n): ")
            if reply.lower() != 'y':
                print("취소됨")
                return
        except EOFError:
            print("비대화형 모드 - --force 옵션을 사용하세요")
            return

    # --cleanup-stale: 중단된 DOE들의 이전 Run 디렉토리 삭제
    if getattr(args, 'cleanup_stale', False):
        import shutil as _shutil
        runner_config = manager.load_runner_config()
        output_dir = runner_config["project"]["output_dir"]
        total_steps = runner_config["scenario"]["total_steps"]
        sim_index = manager._load_simulation_index(runner_config)
        runs = sim_index.get("scenarios", [{}])[0].get("runs", {})
        removed_count = 0
        for doe_idx in target_does:
            for step_num in range(1, total_steps + 1):
                alias = manager._generate_alias(runner_config, doe_idx, step_num)
                run_info = runs.get(alias, {})
                if run_info.get("status") != "completed":
                    folder = run_info.get("folder", "")
                    if folder:
                        run_path = os.path.join(output_dir, folder)
                        if os.path.isdir(run_path):
                            try:
                                _shutil.rmtree(run_path)
                                removed_count += 1
                            except OSError as e:
                                print(f"  경고: {run_path} 삭제 실패: {e}")
        if removed_count > 0:
            print(f"\n중단된 Run 디렉토리 {removed_count}개 삭제 완료")

    print()
    exclude_list = sorted(exclude_nodes) if exclude_nodes else None

    # --sequential 모드: submit의 sequential 로직 재사용
    if getattr(args, 'sequential', False):
        from Runner.JobManager import JobManager as _JM  # noqa: F401
        _rerun_sequential(manager, target_does, exclude_list, args)
    else:
        results = manager.resubmit_does(target_does, exclude_nodes=exclude_list)
        print(f"재제출 완료: {len(results)}개")
        if exclude_list:
            print(f"제외 노드: {exclude_list}")


def cmd_postprocess(args):
    """KooD3plotReader 후처리 수동 실행 (deep / sphere / all).

    runner_config.json에서 base_dir / output_dir 경로 추출,
    각 Run_*/deep_report.sh 와 output_dir/sphere_report.sh를 순차 실행.
    """
    import subprocess
    import json
    config_path = Path(args.config).resolve()
    if not config_path.exists():
        print(f"Error: runner_config not found: {config_path}")
        sys.exit(1)
    with open(config_path) as f:
        runner_config = json.load(f)

    # output_dir 결정
    project = runner_config.get("project", {})
    output_dir = project.get("output_dir") or os.path.join(
        runner_config.get("base_dir", str(config_path.parent)), "output"
    )
    output_dir = str(Path(output_dir).resolve())
    if not os.path.isdir(output_dir):
        print(f"Error: output_dir not found: {output_dir}")
        sys.exit(1)

    # 종합 리포트 routing: scenario mode 로 sphere(DROP) vs impact(IMPACT) 선택.
    from Runner.PostprocessShellGenerator import report_mode_from_runner_config
    report_mode = report_mode_from_runner_config(runner_config)

    if args.deep:
        do_deep, do_sphere, do_impact = True, False, False
    elif args.sphere:
        do_deep, do_sphere, do_impact = False, True, False
    elif getattr(args, "impact", False):
        do_deep, do_sphere, do_impact = False, False, True
    else:
        # --all 또는 무플래그: deep 전부 + scenario mode 에 맞는 종합 리포트 1개
        do_deep = True
        do_impact = (report_mode == "IMPACT")
        do_sphere = not do_impact

    print("=" * 80)
    print(f"KooChainRun - Postprocess (deep={do_deep}, sphere={do_sphere}, "
          f"impact={do_impact}, mode={report_mode})")
    print(f"output_dir: {output_dir}")
    print("=" * 80)

    # postprocess 옵션 (deep_report.sh fallback 생성용)
    pp_opts = runner_config.get("postprocess") or {}

    deep_failed = 0
    deep_done = 0
    if do_deep:
        # DROP(chain/large_scale)는 output/Run_*, DWI(drop_weight_impact)는 케이스 격리 탓에
        # output/results/dwi_*/Run_* 로 한 단계 더 깊다. 둘 다 스캔(비재귀 glob 은 DWI 를 놓쳐
        # deep 가 영영 0개였음). deep 산출물은 build_deep_report_sh 가 <Run_*>/Output/report/
        # 로 남기므로(run_dir=<Run_*>/Output), impact 로더의 _find_deep_output_dir 이 재사용.
        run_dirs = sorted(
            {d for d in (list(Path(output_dir).glob("Run_*"))
                         + list(Path(output_dir).glob("results/*/Run_*")))
             if d.is_dir()}
        )
        print(f"\n[Deep] {len(run_dirs)} Run_* 폴더 발견")
        for rd in run_dirs:
            sh = rd / "deep_report.sh"
            # Fallback: sh 없으면 그때 생성 (시뮬 실패해도 d3plot 있으면 후처리 가능)
            if not sh.exists():
                output_run_dir = rd / "Output"
                if not output_run_dir.exists():
                    print(f"  skip {rd.name}: Output/ 폴더 없음 (d3plot 미생성)")
                    continue
                try:
                    from Runner.PostprocessShellGenerator import build_deep_report_sh
                    sh_text = build_deep_report_sh(
                        run_dir=str(output_run_dir),
                        sif_path=pp_opts.get("sif_path"),
                        options=pp_opts,
                    )
                    with open(sh, 'w') as f:
                        f.write(sh_text)
                    os.chmod(sh, 0o755)
                    print(f"  fallback 생성: {sh.name}")
                except Exception as e:
                    print(f"  skip {rd.name}: deep_report.sh fallback 생성 실패 ({e})")
                    continue
                # 방금 만든 .sh 를 이번 패스에서 바로 실행 — 과거엔 여기서 continue 라
                # 2회차 postprocess 전엔 deep 가 안 돌았음. DWI 는 .sh 선생성 경로가 없어
                # report/analysis_result 가 영영 안 생겼다(impact 로더 성능경로 전제).
            print(f"  running deep: {rd.name}")
            log_path = rd / "deep_report.log"
            with open(log_path, 'w') as logf:
                rc = subprocess.run(
                    ["bash", str(sh)], cwd=str(rd),
                    stdout=logf, stderr=subprocess.STDOUT
                )
            if rc.returncode == 0:
                deep_done += 1
            else:
                deep_failed += 1
                print(f"    ✗ rc={rc.returncode}, log={log_path}")
        print(f"[Deep] done: {deep_done}, failed: {deep_failed}")

    if do_sphere:
        sphere_sh = Path(output_dir) / "sphere_report.sh"
        if not sphere_sh.exists():
            print(f"\n[Sphere] sphere_report.sh 없음: {sphere_sh}")
            print("  prepare 시 postprocess 옵션이 있어야 자동 생성됨")
        else:
            print(f"\n[Sphere] running: {sphere_sh}")
            log_path = Path(output_dir) / "sphere_report.log"
            with open(log_path, 'w') as logf:
                rc = subprocess.run(
                    ["bash", str(sphere_sh)], cwd=output_dir,
                    stdout=logf, stderr=subprocess.STDOUT
                )
            if rc.returncode == 0:
                print(f"  ✓ done")
            else:
                print(f"  ✗ rc={rc.returncode}, log={log_path}")

    if do_impact:
        impact_sh = Path(output_dir) / "impact_report.sh"
        if not impact_sh.exists():
            print(f"\n[Impact] impact_report.sh 없음: {impact_sh}")
            print("  prepare 시 postprocess 옵션이 있어야 자동 생성됨")
        else:
            print(f"\n[Impact] running: {impact_sh}")
            log_path = Path(output_dir) / "impact_report.log"
            with open(log_path, 'w') as logf:
                rc = subprocess.run(
                    ["bash", str(impact_sh)], cwd=output_dir,
                    stdout=logf, stderr=subprocess.STDOUT
                )
            if rc.returncode == 0:
                print(f"  ✓ done")
            else:
                print(f"  ✗ rc={rc.returncode}, log={log_path}")


def cmd_diagnose(args):
    """실패 DOE 원인 진단"""
    from Runner.JobManager import JobManager

    test_dir = Path(args.test_dir).resolve()
    manager = JobManager(str(test_dir))

    print("=" * 80)
    print("KooChainRun - 실패 원인 진단")
    print("=" * 80)

    try:
        diagnoses = manager.diagnose_failures()
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)

    if not diagnoses:
        print("\n실패한 DOE가 없습니다.")
        return

    # 원인별 그룹화
    by_cause = {}
    for d in diagnoses:
        cause = d["cause"]
        by_cause.setdefault(cause, []).append(d)

    cause_labels = {
        "license_error": "라이선스 에러",
        "mpi_error": "MPI 에러",
        "timeout": "타임아웃 (KooMeshModifier/LS-DYNA)",
        "slurm_timeout": "Slurm 시간 초과",
        "disk_full": "디스크 공간 부족",
        "out_of_memory": "메모리 부족",
        "apptainer_error": "Apptainer 에러",
        "cancelled": "수동 취소",
        "killed": "실행 중 종료",
        "failed": "기타 실패",
        "not_started": "실행 안 됨",
    }

    print(f"\n총 실패/미완료 DOE: {len(diagnoses)}개\n")

    for cause, does in sorted(by_cause.items()):
        doe_nums = [d["doe"] for d in does]
        label = cause_labels.get(cause, cause)
        print(f"  [{label}] {len(does)}개")
        print(f"    DOE: {doe_nums}")
        # 첫 번째 진단의 로그 발췌 표시
        excerpt = does[0].get("log_excerpt", "")
        if excerpt:
            # 최대 3줄만 표시
            lines = excerpt.split('\n')[:3]
            for line in lines:
                print(f"    > {line[:120]}")
        print()


