"""

        with open(script_path, 'w') as f:
            f.write(script_content)
        os.chmod(str(script_path), 0o755)
        doe_scripts[doe_idx] = script_path

    # ====================================================================
    # 제출: batch 모드 → Popen + polling, 일반 → 즉시 제출
    # ====================================================================

    def _sbatch_doe(doe_idx, script_path):
        """단일 DOE sbatch 제출"""
        try:
            result = subprocess.run(
                ["sbatch", str(script_path)],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                job_id = result.stdout.strip().split()[-1]
                submitted_jobs.append((doe_idx, job_id))
                print(f"  DOE {doe_idx:3d}: submitted (job {job_id})")
                jobs_data["jobs"][str(doe_idx)] = {
                    "job_id": job_id,
                    "job_name": f"{project_name}_DOE{doe_idx:03d}",
                    "status": "submitted",
                    "submitted_at": datetime.now().isoformat(),
                    "script_path": str(script_path)
                }
                with open(jobs_file, 'w', encoding='utf-8') as jf:
                    json.dump(jobs_data, jf, indent=2, ensure_ascii=False)
                return True
            else:
                print(f"  DOE {doe_idx:3d}: FAILED - {result.stderr.strip()}")
                return False
        except FileNotFoundError:
            print(f"  DOE {doe_idx:3d}: FAILED - sbatch not found")
            return False

    if batch_koomesh and pregenerated_dir and koomesh_cmd:
        # ==============================================================
        # Batch 모드: KooMeshModifier Popen + .done 파일 polling 제출
        # ==============================================================
        import time

        print("-" * 60)
        print("Batch KooMeshModifier 실행 + DOE Job 제출")
        print("-" * 60)
        print(f"  명령어: {' '.join(koomesh_cmd)}")

        koomesh_log = slurm_dir / "batch_koomeshmodifier.log"
        koomesh_logf = open(koomesh_log, 'w')
        proc = subprocess.Popen(
            koomesh_cmd,
            cwd=pregenerated_dir,
            stdout=koomesh_logf,
            stderr=subprocess.STDOUT
        )
        print(f"  PID: {proc.pid}, 로그: {koomesh_log}")

        pending_does = set(range(1, doe_count + 1))
        poll_interval = 2  # 초

        while pending_does:
            # .done 파일 감지 → 즉시 sbatch 제출
            newly_ready = []
            for doe_idx in sorted(pending_does):
                done_path = os.path.join(pregenerated_dir, f"Run_{doe_idx}", ".done")
                if os.path.isfile(done_path):
                    newly_ready.append(doe_idx)

            for doe_idx in newly_ready:
                _sbatch_doe(doe_idx, doe_scripts[doe_idx])
                pending_does.discard(doe_idx)

            # KooMeshModifier 프로세스 종료 확인
            if proc.poll() is not None:
                # 프로세스 종료 → 남은 DOE 한번 더 확인
                for doe_idx in sorted(pending_does):
                    done_path = os.path.join(pregenerated_dir, f"Run_{doe_idx}", ".done")
                    if os.path.isfile(done_path):
                        _sbatch_doe(doe_idx, doe_scripts[doe_idx])
                        pending_does.discard(doe_idx)

                if pending_does:
                    koomesh_logf.close()
                    submitted_count = doe_count - len(pending_does)
                    if proc.returncode != 0:
                        print(f"\n  ❌ KooMeshModifier 실패 (exit code: {proc.returncode})")
                    print(f"  미생성 DOE {len(pending_does)}개: {sorted(pending_does)[:10]}{'...' if len(pending_does) > 10 else ''}")
                    print(f"  제출 완료: {submitted_count}/{doe_count}개")
                    print(f"  미생성 DOE는 제출하지 않습니다.")
                    print(f"  로그 확인: {koomesh_log}")
                    if submitted_count > 0:
                        print(f"\n  이미 제출된 {submitted_count}개 Job은 정상 실행됩니다.")
                        print(f"  실패 DOE 재실행: rerun.sh 사용")
                break

            time.sleep(poll_interval)

        koomesh_logf.close()
        if proc.poll() is None:
            proc.wait()
        print(f"\n  KooMeshModifier 종료 (exit code: {proc.returncode})")

    else:
        # ==============================================================
        # 일반 모드: 모든 DOE 즉시 제출
        # ==============================================================
        print("-" * 60)
        print("Slurm Job 제출")
        print("-" * 60)

        for doe_idx in range(1, doe_count + 1):
            if not _sbatch_doe(doe_idx, doe_scripts[doe_idx]):
                if doe_idx == 1:
                    # 첫 번째에서 sbatch 자체가 실패하면 중단
                    print("  sbatch 실행 불가. 중단합니다.")
                    sys.exit(1)

    print()
    print("=" * 80)
    print(f"Submitted {len(submitted_jobs)}/{doe_count} DOE jobs")
    if scratch_enabled:
        print(f"  모드: Scratch Run (base: {scratch_base})")
    if batch_koomesh:
        print(f"  모드: Batch KooMeshModifier (pregenerated: {pregenerated_dir})")
    print("=" * 80)
    print(f"  Job ID 저장: {jobs_file}")
    print()
    print("Next steps:")
    print(f"  Check status:    squeue -u $USER")
    print(f"  Check logs:      ls {slurm_dir}/doe_*.log")
    print(f"  Cancel all:      KooChainRun stop {config_path.parent}")
    print(f"  Rerun failed:    KooChainRun rerun {config_path.parent}")
    print(f"  Diagnose:        KooChainRun diagnose {config_path.parent}")
    print(f"  Collect results: KooChainRun collect {config_path}")


