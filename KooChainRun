def cmd_stop(args):
    """제출된 모든 작업 취소"""
    from Runner.JobManager import JobManager

    test_dir = Path(args.test_dir).resolve()
    manager = JobManager(str(test_dir))

    print("=" * 80)
    print("KooChainRun - 작업 취소")
    print("=" * 80)

    try:
        results = manager.cancel_all_jobs()
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)

    cancelled = sum(1 for r in results.values() if r["cancel_result"] == "success")
    already = sum(1 for r in results.values() if r["cancel_result"] == "already_done")
    errors = sum(1 for r in results.values() if r["cancel_result"] == "error")

    print()
    for doe_idx in sorted(results.keys()):
        r = results[doe_idx]
        if r["cancel_result"] == "success":
            print(f"  DOE {doe_idx:3d}: 취소 완료 (job {r['job_id']})")
        elif r["cancel_result"] == "already_done":
            print(f"  DOE {doe_idx:3d}: 이미 종료됨 ({r.get('slurm_state', '')})")
        elif r["cancel_result"] == "error":
            print(f"  DOE {doe_idx:3d}: 취소 실패 - {r.get('error', '')}")

    print()
    print(f"취소: {cancelled}개 / 이미 종료: {already}개 / 실패: {errors}개")


def cmd_rerun(args):
    """실패/미완료 DOE만 재실행"""
    from Runner.JobManager import JobManager

    test_dir = Path(args.test_dir).resolve()
    manager = JobManager(str(test_dir))

    print("=" * 80)
    print("KooChainRun - DOE 상태 확인")
    print("=" * 80)

    try:
        status_map = manager.get_doe_status()
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)

    # 상태 테이블 출력
    print()
    print(f"  {'DOE':>5}  {'상태':<15} {'Slurm':<12} {'Step':>8}")
    print("  " + "-" * 45)
    for doe_idx in sorted(status_map.keys()):
        info = status_map[doe_idx]
        step_str = f"{info['steps_completed']}/{info['steps_total']}"
        print(f"  {doe_idx:>5}  {info['status']:<15} {info['slurm_state']:<12} {step_str:>8}")

    # 재실행 대상 결정
    if args.does:
        target_does = [int(d.strip()) for d in args.does.split(",")]
    else:
        target_does = [
            doe_idx for doe_idx, info in status_map.items()
            if info["status"] in ("failed", "killed", "not_started", "license_error")
        ]

    completed = sum(1 for info in status_map.values() if info["status"] == "completed")
    print()
    print(f"완료: {completed}/{len(status_map)}개")

    if not target_does:
        print("재실행 대상 DOE가 없습니다.")
        return

    print(f"재실행 대상: {len(target_does)}개 - DOE {target_does}")

    if args.dry_run:
        print("\n[DRY-RUN] 실제 제출하지 않습니다.")
        return

    if not args.force:
        try:
            reply = input(f"\n{len(target_does)}개 DOE를 재제출하시겠습니까? (y/n): ")
            if reply.lower() != 'y':
                print("취소됨")
                return
        except EOFError:
            print("비대화형 모드 - --force 옵션을 사용하세요")
            return

    print()
    results = manager.resubmit_does(target_does)
    print()
    print(f"재제출 완료: {len(results)}개")


def cmd_diagnose(args):
    """실패 DOE 원인 진단"""
    from Runner.JobManager import JobManager

    test_dir = Path(args.test_dir).resolve()
    manager = JobManager(str(test_dir))

    print("=" * 80)
    print("KooChainRun - 실패 원인 진단")
    print("=" * 80)

    try:
        diagnoses = manager.diagnose_failures()
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)

    if not diagnoses:
        print("\n실패한 DOE가 없습니다.")
        return

    # 원인별 그룹화
    by_cause = {}
    for d in diagnoses:
        cause = d["cause"]
        by_cause.setdefault(cause, []).append(d)

    cause_labels = {
        "license_error": "라이선스 에러",
        "mpi_error": "MPI 에러",
        "timeout": "타임아웃 (KooMeshModifier/LS-DYNA)",
        "slurm_timeout": "Slurm 시간 초과",
        "disk_full": "디스크 공간 부족",
        "out_of_memory": "메모리 부족",
        "apptainer_error": "Apptainer 에러",
        "cancelled": "수동 취소",
        "killed": "실행 중 종료",
        "failed": "기타 실패",
        "not_started": "실행 안 됨",
    }

    print(f"\n총 실패/미완료 DOE: {len(diagnoses)}개\n")

    for cause, does in sorted(by_cause.items()):
        doe_nums = [d["doe"] for d in does]
        label = cause_labels.get(cause, cause)
        print(f"  [{label}] {len(does)}개")
        print(f"    DOE: {doe_nums}")
        # 첫 번째 진단의 로그 발췌 표시
        excerpt = does[0].get("log_excerpt", "")
        if excerpt:
            # 최대 3줄만 표시
            lines = excerpt.split('\n')[:3]
            for line in lines:
                print(f"    > {line[:120]}")
        print()


