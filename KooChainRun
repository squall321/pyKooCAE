        echo "Run 폴더 복사 완료"
    fi

    # DOE별 simulation_index 복사
    if [ -f "$SCRATCH_DIR/output/simulation_index.json" ]; then
        cp $SCRATCH_DIR/output/simulation_index.json \\
           $ORIG_OUTPUT_DIR/simulation_index_doe_{doe_idx:03d}.json 2>/dev/null || true
        echo "Index 파일 복사 완료: simulation_index_doe_{doe_idx:03d}.json"
    fi

    # Scratch 정리
    if [ "{'true' if scratch_cleanup else 'false'}" = "true" ] && [ $EXIT_CODE -eq 0 ]; then
        rm -rf $SCRATCH_DIR
        echo "Scratch 디렉토리 정리 완료"
    else
        echo "Scratch 디렉토리 유지: $SCRATCH_DIR"
    fi

    echo "========================================"
    echo "End: $(date)"
    echo "Exit code: $EXIT_CODE"
    echo "========================================"
