def cmd_submit(args):
    """Execute submit command"""
    import json
    config_path = Path(args.config).resolve()

    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}")
        sys.exit(1)

    # part_validation 모드 분기
    with open(config_path, 'r', encoding='utf-8') as f:
        rc = json.load(f)
    if rc.get("mode") == "part_validation":
        from Runner.PartValidationWorkflow import submit_part_validation
        submit_part_validation(str(config_path), args)
        return

    if args.mode == 'cumulative':
        _submit_cumulative(args, config_path)
    else:
        _submit_large_scale(args, config_path)


