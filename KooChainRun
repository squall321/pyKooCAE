"""
        else:
            if batch_koomesh and pregenerated_dir:
                run_cmd_final = f"{kcr_path} run {config_path} --doe {doe_idx} --skip-koomeshmodifier --pregenerated-dir {pregenerated_dir}"
            else:
                run_cmd_final = f"{kcr_path} run {config_path} --doe {doe_idx}"

            script_content = sbatch_header + f"""{apptainer_tmpdir_line}

echo "========================================"
echo "Job: {job_name}"
echo "DOE: {doe_idx}/{doe_count}"
echo "Node: $(hostname)"
