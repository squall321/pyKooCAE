def _prepare_batch_koomeshmodifier(runner_config, output_dir, env):
    """Batch KooMeshModifier용 config 파일 생성 및 실행 명령어 반환

    batch_config.txt를 생성하고, KooMeshModifier 실행 명령어를 반환합니다.
    실제 실행은 _submit_cumulative()에서 Popen으로 백그라운드 실행합니다.

    Returns:
        tuple: (pregenerated_dir, cmd_list) 성공 시, (None, None) 실패 시
    """
    doe_count = runner_config["scenario"]["doe_count"]
    doe_angles = runner_config["scenario"].get("doe_angles", {})
    model_file = runner_config["project"]["model_file"]
    project_name = runner_config["project"]["name"]
    sim_params = runner_config.get("simulation_params", {})

    pregenerated_dir = str(Path(output_dir) / "pregenerated")
    os.makedirs(pregenerated_dir, exist_ok=True)

    # DOE별 각도 추출 (1-based index)
    rolls, pitches, yaws, runids = [], [], [], []
    for doe_idx in range(1, doe_count + 1):
        doe_key = str(doe_idx)
        if doe_key in doe_angles and "1" in doe_angles[doe_key]:
            angle = doe_angles[doe_key]["1"]
            rolls.append(str(angle["roll"]))
            pitches.append(str(angle["pitch"]))
            yaws.append(str(angle["yaw"]))
        else:
            rolls.append("0")
            pitches.append("0")
            yaws.append("0")
        runids.append(str(doe_idx))

    # simulation_params에서 값 가져오기
    height = sim_params.get("height", 1500)
    tFinal = sim_params.get("tFinal", 0.005)
    dt = sim_params.get("dt", 0.000001)
    density = sim_params.get("density", 7850)
    youngs_modulus = sim_params.get("youngs_modulus", 200000000000)
    poisson_ratio = sim_params.get("poisson_ratio", 0.3)

    # drop_surface 설정
    drop_surface = sim_params.get("drop_surface", {})
    ds_type = drop_surface.get("type", "Plane")
    ds_size = drop_surface.get("size", [300, 300, 20])
    ds_mesh = drop_surface.get("mesh", [30, 30, 2])
    drop_surface_line = f"DropSurface,{ds_type},{ds_size[0]},{ds_size[1]},{ds_size[2]},{ds_mesh[0]},{ds_mesh[1]},{ds_mesh[2]}"

    # roughness 추가 (PlanewithRoughness 타입)
    if ds_type == "PlanewithRoughness":
        roughness = drop_surface.get("roughness_mode", "Random")
        r_max = drop_surface.get("r_max", 0.0)
        sf1 = drop_surface.get("shape_factor", 0.0)
        sf2 = drop_surface.get("shape_factor2", sf1)
        drop_surface_line += f",{roughness},{r_max},{sf1},{sf2}"

    # DeformableToRigid 옵션
    d2r_enabled = drop_surface.get("deformable_to_rigid", False)
    d2r_line = "\nDeformableToRigid,True" if d2r_enabled else ""

    # ── Contact/접촉 옵션 (StepConfigBuilder.build_drop_attitude_config 와 동일 키) ──
    # batch 경로가 자체 config를 쓰면서 이 옵션들을 누락하면, non-batch와 달리
    # SINGLE_SURFACE 자가접촉 part set 이 생성되지 않는다(EnsureSingleSurface 기본 False).
    # StepConfigBuilder(76-131행)와 반드시 동기화할 것.
    convert_to_ss = sim_params.get("convert_general_to_single_surface", True)
    ensure_ss = sim_params.get("ensure_single_surface", False)
    decompose_general = sim_params.get("decompose_general_contact", False)
    robust_contact = sim_params.get("robust_contact", False)
    include_wall_in_general = sim_params.get("include_wall_in_general", False)
    decompose_margin = sim_params.get("decompose_contact_margin", 1.5)
    decompose_abs_margin_x = sim_params.get("decompose_contact_absolute_margin_x", 5.0)
    decompose_abs_margin_y = sim_params.get("decompose_contact_absolute_margin_y", 5.0)
    decompose_abs_margin_z = sim_params.get("decompose_contact_absolute_margin_z", 0.5)
    contact_opt_line = ""
    if not convert_to_ss:
        contact_opt_line += "\nConvertGeneralToSingleSurface,False"
    if ensure_ss:
        contact_opt_line += "\nEnsureSingleSurface,True"
    if decompose_general:
        contact_opt_line += "\nDecomposeGeneralContact,True"
    if decompose_margin != 1.5:
        contact_opt_line += f"\nDecomposeContactMargin,{decompose_margin}"
    if decompose_abs_margin_x != 5.0:
        contact_opt_line += f"\nDecomposeContactAbsoluteMarginX,{decompose_abs_margin_x}"
    if decompose_abs_margin_y != 5.0:
        contact_opt_line += f"\nDecomposeContactAbsoluteMarginY,{decompose_abs_margin_y}"
    if decompose_abs_margin_z != 0.5:
        contact_opt_line += f"\nDecomposeContactAbsoluteMarginZ,{decompose_abs_margin_z}"
    if robust_contact:
        contact_opt_line += "\nRobustContact,True"
        rc_tolerance = sim_params.get("robust_contact_tolerance", 0.1)
        if rc_tolerance != 1.0:
            contact_opt_line += f"\nRobustContactTolerance,{rc_tolerance}"
    if include_wall_in_general:
        contact_opt_line += "\nIncludeWallInGeneral,True"
    if sim_params.get("non_reflecting_boundary", False):
        contact_opt_line += "\nNonReflectingBoundary,True"
    rigidify_dt = sim_params.get("rigidify_small_dt_threshold", 0.0)
    if rigidify_dt > 0:
        contact_opt_line += f"\nRigidifySmallDtThreshold,{rigidify_dt}"
    rigidify_ar = sim_params.get("rigidify_max_aspect_ratio", 0.0)
    if rigidify_ar > 0:
        contact_opt_line += f"\nRigidifyMaxAspectRatio,{rigidify_ar}"
    rigidify_eids = sim_params.get("rigidify_element_ids", [])
    if rigidify_eids:
        contact_opt_line += "\nRigidifyElementIDs," + ",".join(str(e) for e in rigidify_eids)
    tied_opt_line = ""
    for key, val in sim_params.get("tied_options", {}).items():
        tied_opt_line += f"\nTiedOptions.{key},{val}"
    drop_contact_line = ""
    for key, val in sim_params.get("drop_contact", {}).items():
        drop_contact_line += f"\nDropContact.{key},{val}"
    # *CONTROL_TIMESTEP / *CONTROL_HOURGLASS override (StepConfigBuilder 와 동기화)
    control_line = ""
    for key, val in sim_params.get("control_timestep", {}).items():
        control_line += f"\nControlTimestep.{key},{val}"
    for key, val in sim_params.get("control_hourglass", {}).items():
        control_line += f"\nControlHourglass.{key},{val}"

    n = doe_count
    height_list = ",".join([str(height)] * n)
    zeros = ",".join(["0"] * n)

    # batch config 파일 생성
    batch_config_content = f"""*Inputfile
{model_file}
*RunDirectoryMode,True,{pregenerated_dir},{pregenerated_dir}
*Info,{project_name},Step1
*Description,Batch pre-generation for {doe_count} DOEs
*Creator,automation,auto@system.com,CAE,AUTO
*Mode
DROP_ATTITUDE,1
**DropAttitude,1
Runid,{','.join(runids)}
EulerRolling,{','.join(rolls)}
EulerPitching,{','.join(pitches)}
EulerYawing,{','.join(yaws)}
Height,{height_list}
InitialVelocityX,{zeros}
InitialVelocityY,{zeros}
InitialVelocityZ,{zeros}
InitialAngularVelocityX,{zeros}
InitialAngularVelocityY,{zeros}
InitialAngularVelocityZ,{zeros}
OffsetDistance,0.1
Density,{density}
YoungsModulus,{youngs_modulus}
PoissonRatio,{poisson_ratio}
tFinal,{tFinal}
dt,{dt}
{drop_surface_line}{d2r_line}{contact_opt_line}{tied_opt_line}{drop_contact_line}{control_line}
**EndDropAttitude
*End
"""

    batch_config_path = os.path.join(pregenerated_dir, "batch_config.txt")
    with open(batch_config_path, 'w', encoding='utf-8') as f:
        f.write(batch_config_content)

    print(f"  Batch config 생성: {batch_config_path}")

    # KooMeshModifier 실행 명령어 (Apptainer로 래핑하여 헤드노드에서 실행)
    koomesh_path = env.get("koomeshmodifier_path", "/opt/SmartTwinPreprocessor/bin/KooMeshModifier")

    apptainer_sif = env.get("apptainer_sif", "")
    apptainer_bind = env.get("apptainer_bind", "")
    apptainer_env = env.get("apptainer_env", {})
    apptainer_tmpdir = env.get("apptainer_tmpdir", "")

    if apptainer_sif:
        # Apptainer 래핑: 컨테이너 내부 경로 그대로 사용
        if apptainer_tmpdir:
            os.makedirs(apptainer_tmpdir, exist_ok=True)
            os.environ["APPTAINER_TMPDIR"] = apptainer_tmpdir

        cmd = ["apptainer", "exec"]
        if apptainer_bind:
            cmd.extend(["--bind", apptainer_bind])
        for key, value in apptainer_env.items():
            cmd.extend(["--env", f"{key}={value}"])
        cmd.append(apptainer_sif)
        cmd.extend([koomesh_path, batch_config_path])
        print(f"  Apptainer 래핑 사용: {apptainer_sif}")
    else:
        # Apptainer 미설정 시: 호스트 경로로 직접 실행
        if koomesh_path.startswith("/opt/"):
            kcr_host = env.get("koochainrun_path", "")
            if kcr_host:
                host_bin_dir = str(Path(kcr_host).parent)
                host_koomesh = os.path.join(host_bin_dir, "KooMeshModifier")
                if os.path.isfile(host_koomesh):
                    print(f"  KooMeshModifier 호스트 경로 사용: {host_koomesh}")
                    koomesh_path = host_koomesh
        cmd = [koomesh_path, batch_config_path]

    return pregenerated_dir, cmd


def _merge_doe_indexes(output_dir):
    """scratch 모드에서 DOE별로 생성된 simulation_index_doe_N.json 파일들을 병합

    Args:
        output_dir: output 디렉토리 경로

    Returns:
        dict: 병합된 simulation_index 데이터
    """
    import json
    import glob

    merged_index = None
    index_files = sorted(glob.glob(os.path.join(output_dir, "simulation_index_doe_*.json")))

    if not index_files:
        # DOE별 index가 없으면 기존 통합 index 반환
        main_index_path = os.path.join(output_dir, "simulation_index.json")
        if os.path.exists(main_index_path):
            with open(main_index_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        return None

    for idx_file in index_files:
        try:
            with open(idx_file, 'r', encoding='utf-8') as f:
                doe_index = json.load(f)
        except (json.JSONDecodeError, IOError):
            continue

        if merged_index is None:
            merged_index = doe_index
        else:
            # runs 병합 (scenarios[0].runs)
            if "scenarios" in doe_index and doe_index["scenarios"]:
                doe_runs = doe_index["scenarios"][0].get("runs", {})
                merged_index["scenarios"][0]["runs"].update(doe_runs)

    if merged_index:
        # 병합 결과 저장
        merged_path = os.path.join(output_dir, "simulation_index.json")
        with open(merged_path, 'w', encoding='utf-8') as f:
            json.dump(merged_index, f, indent=2, ensure_ascii=False)

    return merged_index


def _submit_cumulative(args, config_path):
    """DOE별 개별 slurm job 제출 (cumulative 방식)

    각 DOE를 독립적인 slurm job으로 제출합니다.
    각 job 내부에서 KooChainRun run --doe N 을 실행하여
    MeshModifier → LS-DYNA → dynain → 다음 step 파이프라인을 수행합니다.

    지원 모드:
      - 기본: 각 DOE에서 KooMeshModifier + LS-DYNA 실행
      - scratch_run: compute node 로컬 scratch에서 실행 후 결과 복사
      - batch_koomeshmodifier: 헤드노드에서 KooMeshModifier 일괄 실행 후 LS-DYNA만 제출
      - scratch_run + batch: 두 기능 결합
    """
    import json
    import subprocess
    import shutil
    import time
    from datetime import datetime

    print("=" * 80)
    print("KooChainRun - Submit Jobs (cumulative mode)")
    print("=" * 80)
    print(f"Config:     {config_path}")

    # runner_config.json 로드하여 DOE 수 확인
    with open(config_path, 'r', encoding='utf-8') as f:
        runner_config = json.load(f)

    doe_count = runner_config["scenario"]["doe_count"]
    project_name = runner_config["project"]["name"]
    output_dir = runner_config["project"]["output_dir"]
    model_file = runner_config["project"]["model_file"]
    model_dir = str(Path(model_file).parent)
    model_basename = Path(model_file).name

    # KooChainRun 실행 파일 경로: environment에서 우선, 없으면 자기 자신 경로
    env = runner_config.get("environment", {})
    kcr_path = env.get("koochainrun_path", str(Path(__file__).resolve()))

    # CLI 인자가 없으면 runner_config.json의 환경 설정에서 읽기
    memory = args.memory or env.get("memory", "64G")
    partition = args.partition if args.partition is not None else env.get("partition", "normal")
    time_limit = args.time_limit if args.time_limit is not None else env.get("time_limit", "24:00:00")

    # DOE 당 예산에 step 수·DR 배율 반영 (step1=1x, step2+ = DR시 2x) — 이후 파티션 cap 적용됨
    _sdf = _step_dr_time_factor(runner_config)
    if _sdf > 1:
        _tl_base = time_limit
        time_limit = _hms_scale(time_limit, _sdf)
        print(f"  Time limit: {_tl_base} × step/DR factor {_sdf} = {time_limit} (per DOE)")

    # 파티션 최대 시간 확인 → time_limit 자동 cap
    try:
        _part_info = subprocess.run(
            ["sinfo", "-p", partition, "-h", "-o", "%l"],
            capture_output=True, text=True, timeout=5
        )
        if _part_info.returncode == 0 and _part_info.stdout.strip():
            _pmax = _part_info.stdout.strip().split("\n")[0].strip()
            if _pmax.upper() != "UNLIMITED":
                # time_limit → 초
                _tl = time_limit.split(":")
                _tl_sec = int(_tl[0]) * 3600 + int(_tl[1]) * 60 + int(_tl[2])
                # partition max → 초 (D-HH:MM:SS 또는 HH:MM:SS)
                _pm = _pmax.split("-")
                _pm_sec = int(_pm[0]) * 86400 if len(_pm) == 2 else 0
                _hms = (_pm[1] if len(_pm) == 2 else _pm[0]).split(":")
                _pm_sec += int(_hms[0]) * 3600 + int(_hms[1]) * 60 + int(_hms[2])
                if _tl_sec > _pm_sec:
                    print(f"  time_limit {time_limit} > partition max {_pmax} → cap to {_pmax}")
                    time_limit = _pmax
    except Exception:
        pass

    ncpu = args.ncpu_per_job if args.ncpu_per_job is not None else env.get("ncpu", 16)

    # apptainer_tmpdir 읽기
    apptainer_tmpdir = env.get("apptainer_tmpdir") or \
                       env.get("apptainer_env", {}).get("APPTAINER_TMPDIR") or \
                       env.get("lsdyna_apptainer_env", {}).get("APPTAINER_TMPDIR")

    # 잡 시작 stagger (동시 완료 방지): 기본 300초 (0이면 비활성)
    job_stagger_seconds = env.get("job_stagger_seconds", 300)

    # scratch_run 설정
    scratch_cfg = env.get("scratch_run", {})
    scratch_enabled = scratch_cfg.get("enabled", False)
    scratch_base = scratch_cfg.get("scratch_base", "/scratch")
    scratch_cleanup = scratch_cfg.get("cleanup_on_success", True)

    # batch_koomeshmodifier 설정
    batch_koomesh = runner_config.get("scenario", {}).get("batch_koomeshmodifier", False)

    print(f"Partition:  {partition}")
    print(f"CPUs/job:   {ncpu}")
    print(f"Memory:     {memory}")
    print(f"Time limit: {time_limit}")
    if apptainer_tmpdir:
        print(f"APPTAINER_TMPDIR: {apptainer_tmpdir}")
    if scratch_enabled:
        print(f"Scratch:    활성 (base: {scratch_base})")
    if batch_koomesh:
        print(f"Batch KooMeshModifier: 활성")
    print()

    print(f"Project:    {project_name}")
    print(f"DOE count:  {doe_count}")
    print(f"Total jobs: {doe_count}")
    if doe_count < args.nodes * args.jobs_per_node:
        print(f"  Note: DOE count ({doe_count}) < requested parallel slots ({args.nodes * args.jobs_per_node})")
        print(f"         Extra nodes will be idle.")

    # 노드 Health Check (advisory):
    #   - SSH ping은 정보 제공용. NodeName이 DNS 미등록인 경우가 많아 신뢰 불가.
    #   - scontrol show nodes에서 NodeAddr(실제 IP) 캐싱 후 IP로 SSH 시도.
    #   - exclude 결정은 SLURM이 down/drain 상태로 마킹한 노드만 (advisory와 무관).
    node_to_addr = {}
    try:
        sc = subprocess.run(
            ["scontrol", "show", "nodes", "--oneliner"],
            capture_output=True, text=True, timeout=10
        )
        if sc.returncode == 0:
            for line in sc.stdout.splitlines():
                m1 = re.search(r"NodeName=(\S+)", line)
                m2 = re.search(r"NodeAddr=(\S+)", line)
                if m1 and m2:
                    node_to_addr[m1.group(1)] = m2.group(1)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    advisory_unreachable = []
    try:
        sinfo_result = subprocess.run(
            ["sinfo", "-N", "-h", "-p", partition, "-t", "idle,mix,alloc", "-o", "%N"],
            capture_output=True, text=True, timeout=10
        )
        if sinfo_result.returncode == 0:
            idle_nodes = list(set(
                n.strip() for n in sinfo_result.stdout.strip().split("\n") if n.strip()
            ))
            if idle_nodes:
                print(f"\nNode Health Check ({len(idle_nodes)} nodes, advisory — exclude는 SLURM down/drain 기준)...")
                ssh_procs = {}
                for node in idle_nodes:
                    target = node_to_addr.get(node, node)  # IP fallback to nodename
                    try:
                        p = subprocess.Popen(
                            ["ssh", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=no",
                             "-o", "BatchMode=yes", target, "hostname"],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE
                        )
                        ssh_procs[node] = (p, target)
                    except Exception:
                        advisory_unreachable.append((node, "spawn-fail"))

                for node, (p, target) in ssh_procs.items():
                    try:
                        p.communicate(timeout=10)
                        if p.returncode != 0:
                            advisory_unreachable.append((node, f"SSH rc={p.returncode} via {target}"))
                    except subprocess.TimeoutExpired:
                        p.kill()
                        p.communicate()
                        advisory_unreachable.append((node, f"TIMEOUT via {target}"))

                if not advisory_unreachable:
                    print(f"  All {len(idle_nodes)} nodes reachable")
                else:
                    for node, why in advisory_unreachable:
                        print(f"  advisory: {node} unreachable ({why}) — SLURM still trusts it, NOT excluded")
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    # exclude는 SLURM이 명확히 down/drain으로 마킹한 노드만
    dead_nodes = []
    try:
        sc_dead = subprocess.run(
            ["sinfo", "-N", "-h", "-p", partition, "-t", "down,drain,fail", "-o", "%N"],
            capture_output=True, text=True, timeout=10
        )
        if sc_dead.returncode == 0:
            dead_nodes = sorted(set(
                n.strip() for n in sc_dead.stdout.strip().split("\n") if n.strip()
            ))
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    exclude_line = ""
    if dead_nodes:
        exclude_str = ",".join(dead_nodes)
        print(f"\n  Excluding {len(dead_nodes)} SLURM down/drain nodes: {exclude_str}")
        exclude_line = f"#SBATCH --exclude={exclude_str}"

    # include 파일 검증
    try:
        sys.path.insert(0, str(Path(__file__).parent / "occProject" / "Generators"))
        sys.path.insert(0, str(Path(__file__).parent / "occProject" / "Generators" / "KooCAEManager"))
        from KooIncludeManager import KooIncludeManager
        inc_mgr = KooIncludeManager(model_file)
        inc_files = inc_mgr.Scan()
        if inc_files:
            print(f"Include files: {len(inc_files)}")
            for f in inc_files:
                print(f"  {Path(f).name}")
        missing = inc_mgr.Validate()
        if missing:
            print(f"  WARNING: Missing include files: {[Path(f).name for f in missing]}")
    except Exception:
        pass  # include 검증 실패해도 제출은 계속

    # additional_files 확인
    additional = env.get("additional_files", [])
    if additional:
        print(f"Additional files: {additional}")

    print()

    # slurm 스크립트 디렉토리 생성
    slurm_dir = Path(output_dir) / "slurm_scripts"
    slurm_dir.mkdir(parents=True, exist_ok=True)

    # NFS 캐시 동기화: 계산노드에서 디렉토리가 즉시 보이도록 보장
    _nfs_sync = slurm_dir / ".nfs_sync"
