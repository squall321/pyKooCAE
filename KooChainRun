def _hms_scale(tl_str: str, mult: int) -> str:
    """HH:MM:SS time limit 문자열을 mult 배로 확장."""
    parts = tl_str.split(":")
    total = int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2])
    total *= mult
    return f"{int(total // 3600)}:{int((total % 3600) // 60):02d}:{int(total % 60):02d}"


def _step_dr_time_factor(runner_config: dict) -> int:
    """DOE 1개의 wall-clock 배율: step1=1x, step2+ 는 DR 켜지면 2x, 아니면 1x.

    time_limit 은 'DOE 당' 예산인데 종전엔 num_steps/DR 을 반영하지 않아
    다스텝(+DR) DOE 가 오버런(--requeue 재큐 낭비)될 수 있었다.
    """
    try:
        total_steps = int(runner_config.get("scenario", {}).get("total_steps", 1))
    except Exception:
        total_steps = 1
    dr_cfg = runner_config.get("simulation_params", {}).get("dynamic_relaxation", False)
    dr_on = bool(dr_cfg.get("enabled", True)) if isinstance(dr_cfg, dict) else bool(dr_cfg)
    per_later_step = 2 if dr_on else 1
    return max(1, 1 + (total_steps - 1) * per_later_step)


def cmd_prepare(args):
    """Execute prepare command"""
    import json
    from Runner.CumulativeDesigner import CumulativeDesigner

    scenario_path = Path(args.scenario).resolve()

    if not scenario_path.exists():
        print(f"❌ Error: Scenario file not found: {scenario_path}")
        sys.exit(1)

    # Determine output path
    if args.output:
        output_path = Path(args.output).resolve()
    else:
        output_path = scenario_path.parent / "runner_config.json"

    print("=" * 80)
    print("KooChainRun - Prepare Configuration")
    print("=" * 80)
    print(f"Scenario: {scenario_path}")
    print(f"Output:   {output_path}")
    print()

    try:
        # Load scenario JSON
        with open(scenario_path, 'r', encoding='utf-8') as f:
            user_config = json.load(f)

        # part_validation 모드 분기
        if user_config.get("mode") == "part_validation":
            from Runner.PartValidationWorkflow import prepare_part_validation
            prepare_part_validation(user_config, scenario_path, output_path)
            return

        # drop_weight_impact 모드 분기
        if user_config.get("mode") == "drop_weight_impact":
            from Runner.DropWeightImpactWorkflow import prepare_drop_weight_impact
            prepare_drop_weight_impact(user_config, scenario_path, output_path)
            return

        # Create designer and parse config
        designer = CumulativeDesigner(user_config, scenario_dir=str(scenario_path.parent))
        runner_config = designer.parse_user_config()

        # Save runner_config.json
        designer.save_runner_config(runner_config, str(output_path))

        # output_dir + slurm_scripts 미리 생성 (NFS 전파 시간 확보)
        with open(str(output_path), 'r', encoding='utf-8') as _f:
            _rc = json.load(_f)
        _output_dir = _rc.get("project", {}).get("output_dir", "")
        if _output_dir:
            _slurm_dir = Path(_output_dir) / "slurm_scripts"
            _slurm_dir.mkdir(parents=True, exist_ok=True)
            print(f"  Output dir: {_output_dir}")

        print(f"✅ Successfully generated: {output_path}")

        # rerun.sh / stop.sh / diagnose.sh / copy.sh 자동 생성
        script_dir = scenario_path.parent
        _generate_helper_scripts(script_dir, user_config)

    except Exception as e:
        print(f"❌ Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


