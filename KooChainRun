    )
    rerun_parser.add_argument(
        '--sequential',
        action='store_true',
        help='남은 DOE를 노드에 분배하여 배치 잡으로 실행 (submit --sequential과 동일)'
    )
    rerun_parser.add_argument(
        '--nodes',
        type=int,
        default=None,
        help='--sequential 모드에서 사용할 노드 수 (기본: 살아있는 노드 자동 감지)'
    )
    rerun_parser.add_argument(
        '--cleanup-stale',
        action='store_true',
        help='재실행 전 중단된 DOE의 이전 Run 디렉토리 자동 삭제 (기본: 안 함)'
    )

    # ========================================================================
    # KooChainRun diagnose: 실패 DOE 원인 진단
    # ========================================================================
    diagnose_parser = subparsers.add_parser(
        'diagnose',
        help='실패 DOE 원인 진단',
        description='실패한 DOE들의 원인을 분석합니다 (라이선스, 타임아웃, 메모리 등)'
    )
    diagnose_parser.add_argument(
        'test_dir',
        nargs='?',
        default='.',
        help='테스트 디렉토리 경로 (기본: 현재 디렉토리)'
    )

    # ========================================================================
    # KooChainRun postprocess: KooD3plotReader 기반 후처리 수동 trigger
    # ========================================================================
    pp_parser = subparsers.add_parser(
        'postprocess',
        help='KooD3plotReader 후처리 수동 실행',
        description='runner_config.json 기반 deep_report / sphere_report 수동 실행. '
                    'auto 옵션 안 줬어도 prepare 시 생성된 sh를 trigger.'
    )
    pp_parser.add_argument('config', help='runner_config.json 경로')
    pp_group = pp_parser.add_mutually_exclusive_group()
    pp_group.add_argument('--deep', action='store_true',
                          help='각 Run_*/deep_report.sh 만 순차 실행')
    pp_group.add_argument('--sphere', action='store_true',
                          help='sphere_report.sh 만 실행 (전각도 DROP)')
    pp_group.add_argument('--impact', action='store_true',
                          help='impact_report.sh 만 실행 (전위치 부분충격 IMPACT)')
    pp_group.add_argument('--all', action='store_true',
                          help='deep 모두 실행 후 종합 리포트 (scenario mode 로 sphere|impact 자동 선택, default)')

    # ========================================================================
    # KooChainRun reprioritize: 완료 결과 기반 대기 잡 우선순위 재배치 (적응 샘플링)
    # ========================================================================
    reprio_parser = subparsers.add_parser(
        'reprioritize',
        help='완료 결과 기반 대기 잡 우선순위 재배치 (위험영역 근처 우선)',
        description='완료된 deep_report 의 per-part 응력 위험을 분석해, 아직 대기 중인 DOE '
                    '잡을 위험영역 근처 방향부터 실행되도록 scontrol top/hold 로 재배치합니다. '
                    '새 잡을 만들지 않습니다(고정 격자 모델 C).'
    )
    reprio_parser.add_argument('test_dir', nargs='?', default='.',
