    reprio_parser.add_argument('--apply', action='store_true',
                               help='실제 scontrol 실행 (기본: dry-run)')
    reprio_parser.add_argument('--radius-deg', type=float, default=25.0,
                               help='핫 방향 근접 커널 반경(deg, 기본 25)')
    reprio_parser.add_argument('--z-thr', type=float, default=1.5,
                               help='핫 판정 z-score 임계(기본 1.5)')
    reprio_parser.add_argument('--yield-factor', type=float, default=1.0,
                               help='핫 판정 yield 절대비 임계(기본 1.0)')
    reprio_parser.add_argument('--top-n', type=int, default=None,
                               help='top 으로 올릴 최대 잡 수(기본 전체)')

    harvest_parser = subparsers.add_parser(
        'harvest',
        help='완료 결과에서 취약 조건(각도/위치)을 뽑아 JSON 으로 방출',
        description='전각도 낙하(sphere_report.json) 또는 전위치 충격(impact_report.json) '
                    '결과에서 위험도 상위 조건을 추려, scenario.json 의 '
                    'angle_source.explicit.file / position_source.manual.file 에 '
                    '그대로 물릴 수 있는 JSON 을 만듭니다. 통합 리포트가 없으면 '
                    '개별 result.json 을 스캔합니다(각도 결과만 가능).'
    )
    harvest_parser.add_argument('test_dir', nargs='?', default='.',
                                help='테스트 디렉토리 (통합 리포트 또는 result.json 이 있는 곳)')
    harvest_parser.add_argument('-o', '--out', default=None,
                                help='출력 JSON 경로 (기본: test_dir/risk_<kind>.json)')
    harvest_parser.add_argument('--top', type=int, default=None,
                                help='위험도 상위 N개만 (기본 전체)')
    harvest_parser.add_argument('--hot-only', action='store_true',
                                help='핫 판정된 조건만')
    harvest_parser.add_argument('--z-thr', type=float, default=1.5,
                                help='핫 판정 z-score 임계(기본 1.5)')
    harvest_parser.add_argument('--yield-factor', type=float, default=1.0,
                                help='핫 판정 yield 절대비 임계(기본 1.0)')
    harvest_parser.add_argument('--parts', default=None,
                                help='이 파트 기준으로만 위험도 계산 (콤마 구분 PID, 예: 12,15). '
                                     '파트이동 DOE 로 옮길 파트가 정해졌을 때 사용. '
                                     '미지정 시 전 파트 최대값')
    harvest_parser.add_argument('--from-scenario', default=None,
                                help='scenario.json 의 part_doe 에서 파트를 자동 추출 '
                                     '(--parts 를 손으로 적는 대신)')
    harvest_parser.add_argument('--yield', dest='yield_uniform', type=float, default=None,
                                help='전 파트 공통 항복강도(MPa). 통합 리포트에는 항복강도가 '
                                     '없어 이걸 줘야 절대 기준(sigma/yield)이 동작한다')
    harvest_parser.add_argument('--yield-by-part', default=None,
                                help='파트별 항복강도. "3:350,7:120" 형식. '
                                     '--yield 보다 우선(개별 지정이 더 구체적)')

    # Parse arguments
    args = parser.parse_args()

    # Execute command
    if args.command == 'prepare':
        cmd_prepare(args)
    elif args.command == 'submit':
        cmd_submit(args)
    elif args.command == 'run':
        cmd_run(args)
    elif args.command == 'status':
        cmd_status(args)
    elif args.command == 'collect':
        cmd_collect(args)
    elif args.command == 'stop':
        cmd_stop(args)
    elif args.command == 'rerun':
        cmd_rerun(args)
    elif args.command == 'diagnose':
        cmd_diagnose(args)
    elif args.command == 'postprocess':
        cmd_postprocess(args)
    elif args.command == 'reprioritize':
        cmd_reprioritize(args)
    elif args.command == 'harvest':
        cmd_harvest(args)
    else:
        parser.print_help()
        sys.exit(1)


def cmd_harvest(args):
    """완료 결과에서 취약 조건을 뽑아 scenario.json 이 물릴 JSON 으로 방출"""
    import json
    from Runner.RiskHarvester import (detect_and_harvest, select,
                                      to_scenario_json, parts_from_scenario,
                                      parse_yield_spec)

    test_dir = Path(args.test_dir).resolve()
    if not test_dir.exists():
        print(f"❌ 디렉토리가 없습니다: {test_dir}")
        sys.exit(1)

    print("=" * 80)
    print("KooChainRun - 취약조건 수확")
    print("=" * 80)

    # 파트 기준 지정 — 옮길 파트가 정해졌으면 그 파트가 가혹한 조건만 뽑는다
    if args.parts and args.from_scenario:
        print("❌ --parts 와 --from-scenario 는 함께 쓸 수 없습니다")
        sys.exit(1)
    pid_list = None
    if args.parts:
        pid_list = [p.strip() for p in args.parts.split(',') if p.strip()]
    elif args.from_scenario:
        try:
            pid_list = parts_from_scenario(args.from_scenario)
        except Exception as e:
            print(f"❌ 파트 추출 실패: {e}")
            sys.exit(1)
        print(f"파트 기준 : {args.from_scenario} 의 part_doe → PID {','.join(pid_list)}")
    if pid_list and not args.from_scenario:
        print(f"파트 기준 : PID {','.join(pid_list)}")
    if not pid_list:
        print("파트 기준 : 전 파트 (최대값)")

    try:
        yields = parse_yield_spec(args.yield_uniform, args.yield_by_part)
    except ValueError as e:
        print(f"❌ {e}")
        sys.exit(1)
    if not yields:
        print("항복강도 : 미지정 — 상대 기준(z-score)만 사용 "
              "(통합 리포트에 항복강도가 없다. --yield 로 주면 절대 기준도 켜진다)")

    try:
        rows, kind, source = detect_and_harvest(
            str(test_dir), z_thr=args.z_thr, yield_factor=args.yield_factor,
            parts_filter=set(pid_list) if pid_list else None,
            yields=yields)
    except Exception as e:
        print(f"❌ 수확 실패: {e}")
        sys.exit(1)

    n_hot = sum(1 for r in rows if r.get("is_hot"))
    label = "각도" if kind == "angles" else "위치"
    print(f"소스     : {source}")
    print(f"전체 {label} : {len(rows)}건 (핫 {n_hot}건)")

    picked = select(rows, top=args.top, hot_only=args.hot_only)
    if not picked:
        print("\n조건에 맞는 케이스가 없습니다. --top 또는 --hot-only 를 완화하세요.")
        sys.exit(1)

    print(f"선별     : {len(picked)}건 (위험도 내림차순)")
    for r in picked[:15]:
        hp = ",".join(f"P{p.get('pid')}" if isinstance(p, dict) else str(p)
                      for p in (r.get("hot_parts") or [])[:3])
        loc = (f"roll={r['roll']:7.2f} pitch={r['pitch']:7.2f}"
               if kind == "angles" else f"x={r['x']:9.3f} y={r['y']:9.3f}")
        flag = "HOT" if r.get("is_hot") else "   "
        print(f"  [{flag}] risk={r.get('risk', 0.0):7.3f}  {r['name']:<28s} {loc}  {hp}")
    if len(picked) > 15:
        print(f"  ... 외 {len(picked) - 15}건")

    out_path = Path(args.out) if args.out else (test_dir / f"risk_{kind}.json")
    doc = to_scenario_json(picked, kind)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=2)

    key = "angle_source.explicit.file" if kind == "angles" else "position_source.manual.file"
    print(f"\n✅ 방출: {out_path}  ({len(doc[kind])}건)")
    print(f"   scenario.json 의 {key} 에 이 경로를 넣으면 됩니다.")
    print(f"   파트이동 DOE 와 곱하려면 같은 시나리오에 part_doe 블록을 추가하세요.")


def cmd_reprioritize(args):
    """완료 결과 기반으로 대기 잡 우선순위 재배치 (적응 샘플링 모델 C)"""
    import json
    from Runner.AdaptiveReprioritize import plan, apply

    test_dir = Path(args.test_dir).resolve()
    rc_path = test_dir / "runner_config.json"
    jj_path = test_dir / "jobs.json"
    if not rc_path.exists() or not jj_path.exists():
        print(f"❌ runner_config.json / jobs.json 필요: {test_dir}")
        sys.exit(1)

    rc = json.load(open(rc_path, encoding="utf-8"))
    jj = json.load(open(jj_path, encoding="utf-8"))
    pl = plan(str(test_dir), rc, jj, radius_deg=args.radius_deg,
              z_thr=args.z_thr, yield_factor=args.yield_factor, top_n=args.top_n)

    print("=" * 80)
    print("KooChainRun - 적응 우선순위 재배치")
    print("=" * 80)
