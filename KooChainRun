    rerun_parser.add_argument(
        'test_dir',
        nargs='?',
        default='.',
        help='테스트 디렉토리 경로 (기본: 현재 디렉토리)'
    )
    rerun_parser.add_argument(
        '--dry-run',
        action='store_true',
        help='실제 제출 없이 상태만 표시'
    )
    rerun_parser.add_argument(
        '--force',
        action='store_true',
        help='확인 없이 즉시 재제출'
    )
    rerun_parser.add_argument(
        '--does',
        type=str,
        default=None,
        help='특정 DOE만 재실행 (콤마 구분, 예: 1,3,7)'
