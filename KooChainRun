def cmd_run(args):
    """Execute run command - single DOE pipeline on compute node"""
    from Runner.CumulativeScenarioRunner import CumulativeScenarioRunner

    config_path = Path(args.config).resolve()

    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}")
        sys.exit(1)

    skip_koomesh = getattr(args, 'skip_koomeshmodifier', False)
    pregenerated_dir = getattr(args, 'pregenerated_dir', None)

    print("=" * 80)
    print(f"KooChainRun - Run DOE {args.doe}")
    print("=" * 80)
    print(f"Config: {config_path}")
    print(f"DOE:    {args.doe}")
    print(f"Resume: {args.resume}")
    if skip_koomesh:
        print(f"Mode:   Batch (KooMeshModifier 생략)")
        print(f"Pregenerated: {pregenerated_dir}")
    print()

    try:
        runner = CumulativeScenarioRunner(
            str(config_path),
            doe_filter=args.doe,
            skip_koomeshmodifier=skip_koomesh,
            pregenerated_dir=pregenerated_dir
        )
        success = runner.run_all()
        if success:
            print(f"DOE {args.doe} completed successfully")
        else:
            print(f"DOE {args.doe} failed")
            sys.exit(1)
    except Exception as e:
        print(f"Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


