    try:
        t = datetime.datetime(now.year, MON[m.group(1)], int(m.group(2)),
                              int(m.group(3)), int(m.group(4)), int(m.group(5) or 0))
    except ValueError:
        return None
    if t > now + datetime.timedelta(days=1):
