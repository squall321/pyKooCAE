    cancelled = sum(1 for r in results.values() if r["cancel_result"] == "success")
    already = sum(1 for r in results.values() if r["cancel_result"] == "already_done")
    errors = sum(1 for r in results.values() if r["cancel_result"] == "error")

    print()
    for doe_idx in sorted(results.keys()):
        r = results[doe_idx]
        if r["cancel_result"] == "success":
            print(f"  DOE {doe_idx:3d}: 취소 완료 (job {r['job_id']})")
        elif r["cancel_result"] == "already_done":
