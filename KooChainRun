def cmd_submit(args):
    """Execute submit command"""
    import json
    config_path = Path(args.config).resolve()

    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}")
        sys.exit(1)

    # part_validation 모드 분기
    with open(config_path, 'r', encoding='utf-8') as f:
        rc = json.load(f)
    if rc.get("mode") == "part_validation":
        from Runner.PartValidationWorkflow import submit_part_validation
        submit_part_validation(str(config_path), args)
        _maybe_submit_sphere_after(rc, config_path)
        return
    if rc.get("mode") == "drop_weight_impact":
        from Runner.DropWeightImpactWorkflow import submit_drop_weight_impact
        submit_drop_weight_impact(str(config_path), args)
        _maybe_submit_sphere_after(rc, config_path)
        return

    if args.mode == 'cumulative':
        _submit_cumulative(args, config_path)
    else:
        _submit_large_scale(args, config_path)

    # 어느 경로건 submit 끝난 후 sphere auto-submit 체크
    _maybe_submit_sphere_after(rc, config_path)


def _maybe_submit_sphere_after(runner_config, config_path):
    """Submit 끝난 후 종합 리포트 dependent job 제출 (scenario mode 로 routing).

    DROP 시나리오 → sphere_report (postprocess.auto_sphere), IMPACT 시나리오 →
    impact_report (postprocess.auto_impact). 둘 다 돌지 않는다 — 과거에는
    auto_sphere 만 검사해 IMPACT 데이터에도 sphere 가 돌던 버그가 있었다.

    어느 submit 경로 (large_scale / cumulative / part_validation / dwi) 끝나든
    공통으로 호출하여 통합. job_id는 jobs.json에서 읽음.
    """
    import json
    import subprocess
    pp = runner_config.get("postprocess")
    if not pp or not pp.get("enabled"):
        return

    try:
        from Runner.PostprocessShellGenerator import (
            build_sphere_sbatch, build_impact_sbatch, report_mode_from_runner_config,
        )
    except Exception as e:
        print(f"[Postprocess] Warning: PostprocessShellGenerator import 실패: {e}")
        return

    # scenario mode 로 sphere vs impact 선택
    mode = report_mode_from_runner_config(runner_config)
    if mode == "IMPACT":
        if not pp.get("auto_impact", True):
            return
        report_label = "Impact"
        sbatch_builder = build_impact_sbatch
        sbatch_name = "impact_report.sbatch"
    else:
        if not pp.get("auto_sphere", True):
            return
        report_label = "Sphere"
        sbatch_builder = build_sphere_sbatch
        sbatch_name = "sphere_report.sbatch"

    # output_dir 결정
    project = runner_config.get("project", {})
    output_dir = project.get("output_dir") or os.path.join(
        runner_config.get("base_dir", str(Path(config_path).parent)), "output"
    )
    output_dir = str(Path(output_dir).resolve())

    # jobs.json에서 모든 job_id 모으기
    jobs_json = os.path.join(Path(config_path).parent, "jobs.json")
    if not os.path.exists(jobs_json):
        # 다른 위치 가능성
        for candidate in [os.path.join(output_dir, "jobs.json"),
                          os.path.join(str(Path(config_path).parent), "jobs.json")]:
            if os.path.exists(candidate):
                jobs_json = candidate
                break
    dep_ids = []
    try:
        with open(jobs_json) as f:
            j = json.load(f)
        jobs = j.get("jobs", {}) or {}
        for k, v in jobs.items():
            if isinstance(v, dict) and v.get("job_id"):
                dep_ids.append(str(v["job_id"]))
    except Exception as e:
        print(f"\n[{report_label} Postprocess] Warning: jobs.json 읽기 실패 ({e}) — dependency 없이 제출")

    env_for_report = dict(runner_config.get("environment", {}))
    sbatch_text = sbatch_builder(
        output_dir=output_dir,
        sif_path=pp.get("sif_path"),
        options=pp,
        environment=env_for_report,
        dependency_ids=dep_ids if dep_ids else None,
    )
    sbatch_path = os.path.join(output_dir, sbatch_name)
    os.makedirs(output_dir, exist_ok=True)
    with open(sbatch_path, 'w') as f:
        f.write(sbatch_text)
    os.chmod(sbatch_path, 0o755)
    print(f"\n[{report_label} Postprocess] sbatch 생성: {sbatch_path}")
    if dep_ids:
        print(f"  Dependency: afterany:{':'.join(dep_ids)}")
    else:
        print(f"  Dependency 없음 (모든 job 즉시 또는 수동 trigger 가능)")

    try:
        result = subprocess.run(
            ["sbatch", sbatch_path],
            capture_output=True, text=True, check=True
        )
        report_job_id = result.stdout.strip().split()[-1]
        print(f"  → {report_label} Job ID: {report_job_id}")
    except Exception as e:
        print(f"  Warning: {report_label.lower()} job 제출 실패: {e}")


