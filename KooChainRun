#!/usr/bin/env python3
"""
KooChainRun (KCR) - Sequential CAE Analysis Workflow Manager

A CLI tool for managing multi-step chained CAE simulations with automatic
Slurm job submission and dependency management.

Author: Koo Engineering
Version: 1.0.0
"""

import sys
import os
import argparse
from pathlib import Path

# Slurm 환경 등에서 locale이 C/ASCII일 때 한글 출력 에러 방지
if sys.stdout.encoding and sys.stdout.encoding.lower() in ('ascii', 'ansi_x3.4-1968'):
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

# Add pyKooCAE to Python path
SCRIPT_DIR = Path(__file__).parent.resolve()
sys.path.insert(0, str(SCRIPT_DIR))


def main():
    """Main entry point for KooChainRun CLI"""
    parser = argparse.ArgumentParser(
        prog='KooChainRun',
        description='KooChainRun - Sequential CAE Analysis Workflow Manager',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Prepare configuration from scenario
  KooChainRun prepare scenario.json

  # Submit jobs to Slurm
  KooChainRun submit runner_config.json --nodes 10 --jobs-per-node 4 --ncpu-per-job 16

  # Check execution status
  KooChainRun status

  # Collect results
  KooChainRun collect runner_config.json results/

For more information, visit: https://github.com/kooengineering/pyKooCAE
        """
    )

    parser.add_argument('--version', action='version', version='KooChainRun 1.0.0')

    subparsers = parser.add_subparsers(dest='command', help='Available commands')

    # ========================================================================
    # KooChainRun prepare: scenario.json → runner_config.json
    # ========================================================================
    prepare_parser = subparsers.add_parser(
        'prepare',
        help='Generate runner configuration from scenario',
        description='Convert user-friendly scenario.json to detailed runner_config.json'
    )
    prepare_parser.add_argument(
        'scenario',
        help='Path to scenario.json file'
    )
    prepare_parser.add_argument(
        '-o', '--output',
        help='Output runner_config.json path (default: same directory as scenario)',
        default=None
    )

    # ========================================================================
    # KooChainRun submit: Submit jobs to Slurm
    # ========================================================================
    submit_parser = subparsers.add_parser(
        'submit',
        help='Submit jobs to Slurm cluster',
        description='Create directories, generate metadata, and submit Slurm array jobs'
    )
    submit_parser.add_argument(
        'config',
        help='Path to runner_config.json file'
    )
    submit_parser.add_argument(
        '--mode',
        choices=['large-scale', 'cumulative'],
        default='cumulative',
        help='Submission mode: "cumulative" submits per-DOE slurm jobs using KooChainRun run, '
             '"large-scale" uses LargeScaleDOEManager array jobs (default: cumulative)'
    )
    submit_parser.add_argument(
        '--nodes',
        type=int,
        default=2,
        help='Number of nodes to use (default: 2)'
    )
    submit_parser.add_argument(
        '--jobs-per-node',
        type=int,
        default=4,
        help='Number of concurrent jobs per node (default: 4)'
    )
    submit_parser.add_argument(
        '--ncpu-per-job',
        type=int,
        default=None,
        help='Number of CPUs per job (default: runner_config.json environment.ncpu, fallback 16)'
    )
    submit_parser.add_argument(
        '--partition',
        default='normal',
        help='Slurm partition (default: normal)'
    )
    submit_parser.add_argument(
        '--memory',
        default=None,
        help='Memory per DOE job (default: from runner_config.json environment.memory, or 64G)'
    )
    submit_parser.add_argument(
        '--time-limit',
        default='24:00:00',
        help='Time limit per DOE job (default: 24:00:00)'
    )
    submit_parser.add_argument(
        '--data-root',
        default='/data',
        help='Root directory for execution (default: /data)'
    )

    # ========================================================================
    # KooChainRun status: Check execution status
    # ========================================================================
    status_parser = subparsers.add_parser(
        'status',
        help='Check execution status',
        description='Monitor progress of running simulations'
    )
    status_parser.add_argument(
        'config',
        nargs='?',
        help='Path to runner_config.json file (optional)'
    )
    status_parser.add_argument(
        '--watch',
        action='store_true',
        help='Continuously monitor status (update every 60s)'
    )

    # ========================================================================
    # KooChainRun run: Run single DOE pipeline (for compute node execution)
    # ========================================================================
    run_parser = subparsers.add_parser(
        'run',
        help='Run single DOE pipeline on compute node',
        description='Execute a single DOE cumulative pipeline (MeshModifier → LS-DYNA → dynain → next step). '
                    'Designed to be called from within a Slurm job.'
    )
    run_parser.add_argument(
        'config',
        help='Path to runner_config.json file'
    )
    run_parser.add_argument(
        '--doe',
        type=int,
        required=True,
        help='DOE index to run (1-based)'
    )
    run_parser.add_argument(
        '--resume',
        action='store_true',
        help='Resume from checkpoint'
    )
    run_parser.add_argument(
        '--skip-koomeshmodifier',
        action='store_true',
        help='KooMeshModifier 실행 생략 (batch 사전 생성 모드에서 사용)'
    )
    run_parser.add_argument(
        '--pregenerated-dir',
        type=str,
        default=None,
        help='사전 생성된 DropSet.k 파일이 있는 디렉토리 경로'
    )

    # ========================================================================
    # KooChainRun collect: Collect results
    # ========================================================================
    collect_parser = subparsers.add_parser(
        'collect',
        help='Collect simulation results',
        description='Gather completed results from execution directory'
    )
    collect_parser.add_argument(
        'config',
        help='Path to runner_config.json file'
    )
    collect_parser.add_argument(
        'output_dir',
        nargs='?',
        default='./results',
        help='Output directory for collected results (default: ./results)'
    )

    # ========================================================================
    # KooChainRun stop: 제출된 모든 작업 취소
    # ========================================================================
    stop_parser = subparsers.add_parser(
        'stop',
        help='제출된 모든 작업 취소',
        description='jobs.json에 저장된 Slurm 작업을 모두 취소합니다'
    )
    stop_parser.add_argument(
        'test_dir',
        nargs='?',
        default='.',
        help='테스트 디렉토리 경로 (기본: 현재 디렉토리)'
    )

    # ========================================================================
    # KooChainRun rerun: 실패/미완료 DOE만 재실행
    # ========================================================================
    rerun_parser = subparsers.add_parser(
        'rerun',
        help='실패/미완료 DOE만 재실행',
        description='실패하거나 완료되지 않은 DOE만 식별하여 재제출합니다'
    )
    rerun_parser.add_argument(
        'test_dir',
        nargs='?',
        default='.',
        help='테스트 디렉토리 경로 (기본: 현재 디렉토리)'
    )
    rerun_parser.add_argument(
        '--dry-run',
        action='store_true',
        help='실제 제출 없이 상태만 표시'
    )
    rerun_parser.add_argument(
        '--force',
        action='store_true',
        help='확인 없이 즉시 재제출'
    )
    rerun_parser.add_argument(
        '--does',
        type=str,
        default=None,
        help='특정 DOE만 재실행 (콤마 구분, 예: 1,3,7)'
    )

    # ========================================================================
    # KooChainRun diagnose: 실패 DOE 원인 진단
    # ========================================================================
    diagnose_parser = subparsers.add_parser(
        'diagnose',
        help='실패 DOE 원인 진단',
        description='실패한 DOE들의 원인을 분석합니다 (라이선스, 타임아웃, 메모리 등)'
    )
    diagnose_parser.add_argument(
        'test_dir',
        nargs='?',
        default='.',
        help='테스트 디렉토리 경로 (기본: 현재 디렉토리)'
    )

    # Parse arguments
    args = parser.parse_args()

    # Execute command
    if args.command == 'prepare':
        cmd_prepare(args)
    elif args.command == 'submit':
        cmd_submit(args)
    elif args.command == 'run':
        cmd_run(args)
    elif args.command == 'status':
        cmd_status(args)
    elif args.command == 'collect':
        cmd_collect(args)
    elif args.command == 'stop':
        cmd_stop(args)
    elif args.command == 'rerun':
        cmd_rerun(args)
    elif args.command == 'diagnose':
        cmd_diagnose(args)
    else:
        parser.print_help()
        sys.exit(1)


def cmd_prepare(args):
    """Execute prepare command"""
    import json
    from Runner.CumulativeDesigner import CumulativeDesigner

    scenario_path = Path(args.scenario).resolve()

    if not scenario_path.exists():
        print(f"❌ Error: Scenario file not found: {scenario_path}")
        sys.exit(1)

    # Determine output path
    if args.output:
        output_path = Path(args.output).resolve()
    else:
        output_path = scenario_path.parent / "runner_config.json"

    print("=" * 80)
    print("KooChainRun - Prepare Configuration")
    print("=" * 80)
    print(f"Scenario: {scenario_path}")
    print(f"Output:   {output_path}")
    print()

    try:
        # Load scenario JSON
        with open(scenario_path, 'r', encoding='utf-8') as f:
            user_config = json.load(f)

        # Create designer and parse config
        designer = CumulativeDesigner(user_config, scenario_dir=str(scenario_path.parent))
        runner_config = designer.parse_user_config()

        # Save runner_config.json
        designer.save_runner_config(runner_config, str(output_path))

        print(f"✅ Successfully generated: {output_path}")

        # rerun.sh / stop.sh / diagnose.sh / copy.sh 자동 생성
        script_dir = scenario_path.parent
        _generate_helper_scripts(script_dir, runner_config)

    except Exception as e:
        print(f"❌ Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


def _generate_helper_scripts(script_dir: Path, runner_config: dict = None):
    """rerun.sh, stop.sh, diagnose.sh, copy.sh 자동 생성"""
    import stat
    scripts = {
        "rerun.sh":   '"$KOOCR" rerun "$SCRIPT_DIR" "$@"',
        "stop.sh":    '"$KOOCR" stop "$SCRIPT_DIR"\n# 로컬 scratch 정리\nbash "$SCRIPT_DIR/clean.sh" 2>/dev/null || true',
        "diagnose.sh": '"$KOOCR" diagnose "$SCRIPT_DIR"',
    }
    header = (
        '#!/bin/bash\n'
        'SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"\n'
        'KOOCR=$(python3 -c "import json; print(json.load(open(\'$SCRIPT_DIR/scenario.json\'))[\'environment\'][\'koochainrun_path\'])")\n'
    )
    for filename, cmd in scripts.items():
        path = script_dir / filename
        path.write_text(header + cmd + "\n", encoding="utf-8")
        path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    # copy.sh 생성 (로컬 scratch → NFS 동기화)
    env = {}
    if runner_config:
        env = runner_config.get("environment", {})
    tmpdir = env.get("apptainer_tmpdir", "/opt/tmp")
    output_dir = str(script_dir / "output")

    copy_script = f'''#!/bin/bash
# copy.sh - 로컬 scratch에서 NFS Output으로 결과 동기화
# 용량 동일한 파일은 스킵, 5스레드 병렬로 NFS burst 방지
set -e

SCRATCH_BASE="{tmpdir}"
OUTPUT_DIR="{output_dir}"
MAX_THREADS=${{1:-5}}

echo "========================================"
echo "로컬 scratch -> NFS Output 동기화"
echo "========================================"
echo "Scratch base: $SCRATCH_BASE"
echo "Output: $OUTPUT_DIR"
echo "스레드: $MAX_THREADS"
echo ""

NODES=$(squeue -u $USER --format="%N" --noheader 2>/dev/null | sort -u)
if [ -z "$NODES" ]; then
    echo "실행 중인 job 없음"
    exit 0
fi

sync_remote() {{
    local entry="$1"
    local node="${{entry%%:*}}"
    local remote_dir="${{entry#*:}}"
    local run_name=$(basename "$remote_dir")
    local nfs_output="$OUTPUT_DIR/$run_name/Output"
    mkdir -p "$nfs_output"
    rsync -a --size-only -e "ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no" "$node:$remote_dir/" "$nfs_output/" 2>/dev/null
    echo "  OK: $node:$run_name"
}}
export -f sync_remote
export OUTPUT_DIR

ENTRIES=""
for NODE in $NODES; do
    echo "노드 탐색: $NODE"
    DIRS=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$NODE" \\
        "find $SCRATCH_BASE/apptainer_job_*/run_* -maxdepth 0 -type d 2>/dev/null" 2>/dev/null || true)
    for DIR in $DIRS; do
        echo "  발견: $NODE:$DIR"
        ENTRIES="$ENTRIES $NODE:$DIR"
    done
done

if [ -z "$ENTRIES" ]; then
    echo "동기화할 scratch 디렉토리 없음"
    exit 0
fi

echo ""
echo "동기화 시작..."
echo "----------------------------------------"
echo "$ENTRIES" | tr ' ' '\\n' | grep -v '^$' | xargs -P $MAX_THREADS -I {{}} bash -c 'sync_remote "$@"' _ {{}}

echo ""
echo "========================================"
echo "동기화 완료"
echo "========================================"
'''
    copy_path = script_dir / "copy.sh"
    copy_path.write_text(copy_script, encoding="utf-8")
    copy_path.chmod(copy_path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    # clean.sh 생성 (로컬 scratch 정리)
    clean_script = f'''#!/bin/bash
# clean.sh - 이 프로젝트 job의 로컬 scratch만 정리
set -e

SCRIPT_DIR="$(cd "$(dirname "${{BASH_SOURCE[0]}}")" && pwd)"
SCRATCH_BASE="{tmpdir}"
JOBS_FILE="$SCRIPT_DIR/jobs.json"

echo "========================================"
echo "로컬 scratch 정리 (이 프로젝트만)"
echo "========================================"
echo "Scratch base: $SCRATCH_BASE"

# jobs.json에서 이 프로젝트의 job ID 목록 추출
if [ ! -f "$JOBS_FILE" ]; then
    echo "jobs.json 없음"
    exit 0
fi

JOB_IDS=$(python3 -c "
import json
d = json.load(open('$JOBS_FILE'))
for k, v in d.get('jobs', {{}}).items():
    print(v.get('job_id', ''))
" 2>/dev/null | grep -v '^$')

if [ -z "$JOB_IDS" ]; then
    echo "정리할 job ID 없음"
    exit 0
fi

echo "대상 Job IDs: $(echo $JOB_IDS | tr '\\n' ' ')"
echo ""

NODES=$(sinfo -N --noheader --format="%N" 2>/dev/null | sort -u)
if [ -z "$NODES" ]; then
    NODES=$(squeue -u $USER --format="%N" --noheader 2>/dev/null | sort -u)
fi

TOTAL=0
for NODE in $NODES; do
    for JID in $JOB_IDS; do
        TARGET="$SCRATCH_BASE/apptainer_job_$JID"
        EXISTS=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$NODE" \\
            "[ -d $TARGET ] && echo yes || echo no" 2>/dev/null || echo "no")
        if [ "$EXISTS" = "yes" ]; then
            ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$NODE" \\
                "rm -rf $TARGET" 2>/dev/null || true
            echo "  $NODE: $TARGET 삭제"
            TOTAL=$((TOTAL + 1))
        fi
    done
done

echo ""
echo "총 $TOTAL 디렉토리 정리 완료"
'''
    clean_path = script_dir / "clean.sh"
    clean_path.write_text(clean_script, encoding="utf-8")
    clean_path.chmod(clean_path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    print(f"✅ Helper scripts generated: rerun.sh, stop.sh, diagnose.sh, copy.sh, clean.sh")


def cmd_submit(args):
    """Execute submit command"""
    config_path = Path(args.config).resolve()

    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}")
        sys.exit(1)

    if args.mode == 'cumulative':
        _submit_cumulative(args, config_path)
    else:
        _submit_large_scale(args, config_path)


def _submit_large_scale(args, config_path):
    """LargeScaleDOEManager 기반 제출 (기존 방식)"""
    import json
    from Runner.LargeScaleDOEManager import LargeScaleDOEManager

    with open(config_path, 'r', encoding='utf-8') as f:
        runner_config = json.load(f)
    env = runner_config.get("environment", {})
    ncpu = args.ncpu_per_job if args.ncpu_per_job is not None else env.get("ncpu", 16)

    print("=" * 80)
    print("KooChainRun - Submit Jobs (large-scale mode)")
    print("=" * 80)
    print(f"Config:         {config_path}")
    print(f"Nodes:          {args.nodes}")
    print(f"Jobs per node:  {args.jobs_per_node}")
    print(f"CPUs per job:   {ncpu}")
    print(f"Total parallel: {args.nodes * args.jobs_per_node}")
    print()

    try:
        manager = LargeScaleDOEManager(
            runner_config_path=str(config_path),
            data_root=args.data_root,
            nodes=args.nodes,
            jobs_per_node=args.jobs_per_node,
            ncpu_per_job=ncpu
        )
        manager.run()
        print()
        print("=" * 80)
        print("Jobs submitted successfully")
        print("=" * 80)
        print()
        print("Next steps:")
        print(f"  Check status:    KooChainRun status {config_path}")
        print(f"  Collect results: KooChainRun collect {config_path}")
    except Exception as e:
        print(f"Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


def _prepare_batch_koomeshmodifier(runner_config, output_dir, env):
    """Batch KooMeshModifier용 config 파일 생성 및 실행 명령어 반환

    batch_config.txt를 생성하고, KooMeshModifier 실행 명령어를 반환합니다.
    실제 실행은 _submit_cumulative()에서 Popen으로 백그라운드 실행합니다.

    Returns:
        tuple: (pregenerated_dir, cmd_list) 성공 시, (None, None) 실패 시
    """
    doe_count = runner_config["scenario"]["doe_count"]
    doe_angles = runner_config["scenario"].get("doe_angles", {})
    model_file = runner_config["project"]["model_file"]
    project_name = runner_config["project"]["name"]
    sim_params = runner_config.get("simulation_params", {})

    pregenerated_dir = str(Path(output_dir) / "pregenerated")
    os.makedirs(pregenerated_dir, exist_ok=True)

    # DOE별 각도 추출 (1-based index)
    rolls, pitches, yaws, runids = [], [], [], []
    for doe_idx in range(1, doe_count + 1):
        doe_key = str(doe_idx)
        if doe_key in doe_angles and "1" in doe_angles[doe_key]:
            angle = doe_angles[doe_key]["1"]
            rolls.append(str(angle["roll"]))
            pitches.append(str(angle["pitch"]))
            yaws.append(str(angle["yaw"]))
        else:
            rolls.append("0")
            pitches.append("0")
            yaws.append("0")
        runids.append(str(doe_idx))

    # simulation_params에서 값 가져오기
    height = sim_params.get("height", 1500)
    tFinal = sim_params.get("tFinal", 0.005)
    dt = sim_params.get("dt", 0.000001)
    density = sim_params.get("density", 7850)
    youngs_modulus = sim_params.get("youngs_modulus", 200000000000)
    poisson_ratio = sim_params.get("poisson_ratio", 0.3)

    # drop_surface 설정
    drop_surface = sim_params.get("drop_surface", {})
    ds_type = drop_surface.get("type", "Plane")
    ds_size = drop_surface.get("size", [300, 300, 20])
    ds_mesh = drop_surface.get("mesh", [30, 30, 2])
    drop_surface_line = f"DropSurface,{ds_type},{ds_size[0]},{ds_size[1]},{ds_size[2]},{ds_mesh[0]},{ds_mesh[1]},{ds_mesh[2]}"

    # roughness 추가 (PlanewithRoughness 타입)
    if ds_type == "PlanewithRoughness":
        roughness = drop_surface.get("roughness_mode", "Random")
        r_max = drop_surface.get("r_max", 0.0)
        sf1 = drop_surface.get("shape_factor", 0.0)
        sf2 = drop_surface.get("shape_factor2", sf1)
        drop_surface_line += f",{roughness},{r_max},{sf1},{sf2}"

    # DeformableToRigid 옵션
    d2r_enabled = drop_surface.get("deformable_to_rigid", False)
    d2r_line = "\nDeformableToRigid,True" if d2r_enabled else ""

    n = doe_count
    height_list = ",".join([str(height)] * n)
    zeros = ",".join(["0"] * n)

    # batch config 파일 생성
    batch_config_content = f"""*Inputfile
{model_file}
*RunDirectoryMode,True,{pregenerated_dir},{pregenerated_dir}
*Info,{project_name},Step1
*Description,Batch pre-generation for {doe_count} DOEs
*Creator,automation,auto@system.com,CAE,AUTO
*Mode
DROP_ATTITUDE,1
**DropAttitude,1
Runid,{','.join(runids)}
EulerRolling,{','.join(rolls)}
EulerPitching,{','.join(pitches)}
EulerYawing,{','.join(yaws)}
Height,{height_list}
InitialVelocityX,{zeros}
InitialVelocityY,{zeros}
InitialVelocityZ,{zeros}
InitialAngularVelocityX,{zeros}
InitialAngularVelocityY,{zeros}
InitialAngularVelocityZ,{zeros}
OffsetDistance,0.1
Density,{density}
YoungsModulus,{youngs_modulus}
PoissonRatio,{poisson_ratio}
tFinal,{tFinal}
dt,{dt}
{drop_surface_line}{d2r_line}
**EndDropAttitude
*End
"""

    batch_config_path = os.path.join(pregenerated_dir, "batch_config.txt")
    with open(batch_config_path, 'w', encoding='utf-8') as f:
        f.write(batch_config_content)

    print(f"  Batch config 생성: {batch_config_path}")

    # KooMeshModifier 실행 명령어 (Apptainer로 래핑하여 헤드노드에서 실행)
    koomesh_path = env.get("koomeshmodifier_path", "/opt/SmartTwinPreprocessor/bin/KooMeshModifier")

    apptainer_sif = env.get("apptainer_sif", "")
    apptainer_bind = env.get("apptainer_bind", "")
    apptainer_env = env.get("apptainer_env", {})
    apptainer_tmpdir = env.get("apptainer_tmpdir", "")

    if apptainer_sif:
        # Apptainer 래핑: 컨테이너 내부 경로 그대로 사용
        if apptainer_tmpdir:
            os.makedirs(apptainer_tmpdir, exist_ok=True)
            os.environ["APPTAINER_TMPDIR"] = apptainer_tmpdir

        cmd = ["apptainer", "exec"]
        if apptainer_bind:
            cmd.extend(["--bind", apptainer_bind])
        for key, value in apptainer_env.items():
            cmd.extend(["--env", f"{key}={value}"])
        cmd.append(apptainer_sif)
        cmd.extend([koomesh_path, batch_config_path])
        print(f"  Apptainer 래핑 사용: {apptainer_sif}")
    else:
        # Apptainer 미설정 시: 호스트 경로로 직접 실행
        if koomesh_path.startswith("/opt/"):
            kcr_host = env.get("koochainrun_path", "")
            if kcr_host:
                host_bin_dir = str(Path(kcr_host).parent)
                host_koomesh = os.path.join(host_bin_dir, "KooMeshModifier")
                if os.path.isfile(host_koomesh):
                    print(f"  KooMeshModifier 호스트 경로 사용: {host_koomesh}")
                    koomesh_path = host_koomesh
        cmd = [koomesh_path, batch_config_path]

    return pregenerated_dir, cmd


def _merge_doe_indexes(output_dir):
    """scratch 모드에서 DOE별로 생성된 simulation_index_doe_N.json 파일들을 병합

    Args:
        output_dir: output 디렉토리 경로

    Returns:
        dict: 병합된 simulation_index 데이터
    """
    import json
    import glob

    merged_index = None
    index_files = sorted(glob.glob(os.path.join(output_dir, "simulation_index_doe_*.json")))

    if not index_files:
        # DOE별 index가 없으면 기존 통합 index 반환
        main_index_path = os.path.join(output_dir, "simulation_index.json")
        if os.path.exists(main_index_path):
            with open(main_index_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        return None

    for idx_file in index_files:
        try:
            with open(idx_file, 'r', encoding='utf-8') as f:
                doe_index = json.load(f)
        except (json.JSONDecodeError, IOError):
            continue

        if merged_index is None:
            merged_index = doe_index
        else:
            # runs 병합 (scenarios[0].runs)
            if "scenarios" in doe_index and doe_index["scenarios"]:
                doe_runs = doe_index["scenarios"][0].get("runs", {})
                merged_index["scenarios"][0]["runs"].update(doe_runs)

    if merged_index:
        # 병합 결과 저장
        merged_path = os.path.join(output_dir, "simulation_index.json")
        with open(merged_path, 'w', encoding='utf-8') as f:
            json.dump(merged_index, f, indent=2, ensure_ascii=False)

    return merged_index


def _submit_cumulative(args, config_path):
    """DOE별 개별 slurm job 제출 (cumulative 방식)

    각 DOE를 독립적인 slurm job으로 제출합니다.
    각 job 내부에서 KooChainRun run --doe N 을 실행하여
    MeshModifier → LS-DYNA → dynain → 다음 step 파이프라인을 수행합니다.

    지원 모드:
      - 기본: 각 DOE에서 KooMeshModifier + LS-DYNA 실행
      - scratch_run: compute node 로컬 scratch에서 실행 후 결과 복사
      - batch_koomeshmodifier: 헤드노드에서 KooMeshModifier 일괄 실행 후 LS-DYNA만 제출
      - scratch_run + batch: 두 기능 결합
    """
    import json
    import subprocess
    import shutil
    from datetime import datetime

    print("=" * 80)
    print("KooChainRun - Submit Jobs (cumulative mode)")
    print("=" * 80)
    print(f"Config:     {config_path}")

    # runner_config.json 로드하여 DOE 수 확인
    with open(config_path, 'r', encoding='utf-8') as f:
        runner_config = json.load(f)

    doe_count = runner_config["scenario"]["doe_count"]
    project_name = runner_config["project"]["name"]
    output_dir = runner_config["project"]["output_dir"]
    model_file = runner_config["project"]["model_file"]
    model_dir = str(Path(model_file).parent)
    model_basename = Path(model_file).name

    # KooChainRun 실행 파일 경로: environment에서 우선, 없으면 자기 자신 경로
    env = runner_config.get("environment", {})
    kcr_path = env.get("koochainrun_path", str(Path(__file__).resolve()))

    # CLI 인자가 없으면 runner_config.json의 환경 설정에서 읽기
    memory = args.memory or env.get("memory", "64G")
    partition = args.partition if args.partition != 'normal' else env.get("partition", "normal")
    time_limit = args.time_limit if args.time_limit != '24:00:00' else env.get("time_limit", "24:00:00")
    ncpu = args.ncpu_per_job if args.ncpu_per_job is not None else env.get("ncpu", 16)

    # apptainer_tmpdir 읽기
    apptainer_tmpdir = env.get("apptainer_tmpdir") or \
                       env.get("apptainer_env", {}).get("APPTAINER_TMPDIR") or \
                       env.get("lsdyna_apptainer_env", {}).get("APPTAINER_TMPDIR")

    # scratch_run 설정
    scratch_cfg = env.get("scratch_run", {})
    scratch_enabled = scratch_cfg.get("enabled", False)
    scratch_base = scratch_cfg.get("scratch_base", "/scratch")
    scratch_cleanup = scratch_cfg.get("cleanup_on_success", True)

    # batch_koomeshmodifier 설정
    batch_koomesh = runner_config.get("scenario", {}).get("batch_koomeshmodifier", False)

    print(f"Partition:  {partition}")
    print(f"CPUs/job:   {ncpu}")
    print(f"Memory:     {memory}")
    print(f"Time limit: {time_limit}")
    if apptainer_tmpdir:
        print(f"APPTAINER_TMPDIR: {apptainer_tmpdir}")
    if scratch_enabled:
        print(f"Scratch:    활성 (base: {scratch_base})")
    if batch_koomesh:
        print(f"Batch KooMeshModifier: 활성")
    print()

    print(f"Project:    {project_name}")
    print(f"DOE count:  {doe_count}")
    print(f"Total jobs: {doe_count}")
    print()

    # slurm 스크립트 디렉토리 생성
    slurm_dir = Path(output_dir) / "slurm_scripts"
    slurm_dir.mkdir(parents=True, exist_ok=True)

    # jobs.json 준비 (기존 파일 백업)
    jobs_file = config_path.parent / "jobs.json"
    if jobs_file.exists():
        bak_file = config_path.parent / "jobs.json.bak"
        shutil.copy2(str(jobs_file), str(bak_file))

    jobs_data = {
        "project_name": project_name,
        "config_path": str(config_path),
        "submitted_at": datetime.now().isoformat(),
        "doe_count": doe_count,
        "scratch_run": scratch_enabled,
        "batch_koomeshmodifier": batch_koomesh,
        "jobs": {}
    }

    submitted_jobs = []

    # ====================================================================
    # DOE sbatch 스크립트 사전 생성 (batch/일반 공통)
    # ====================================================================
    apptainer_tmpdir_line = f"export APPTAINER_TMPDIR={apptainer_tmpdir}" if apptainer_tmpdir else "# APPTAINER_TMPDIR not configured"

    # batch 모드: config 준비
    pregenerated_dir = None
    koomesh_cmd = None
    if batch_koomesh:
        pregenerated_dir, koomesh_cmd = _prepare_batch_koomeshmodifier(runner_config, output_dir, env)
        if pregenerated_dir is None:
            print("  Batch config 생성 실패. 일반 모드로 전환합니다.")
            batch_koomesh = False

    # DOE별 sbatch 스크립트 생성
    doe_scripts = {}  # doe_idx → script_path
    for doe_idx in range(1, doe_count + 1):
        job_name = f"{project_name}_DOE{doe_idx:03d}"
        script_path = slurm_dir / f"run_doe_{doe_idx:03d}.sh"
        log_path = slurm_dir / f"doe_{doe_idx:03d}_%j.log"

        sbatch_header = f"""#!/bin/bash
#SBATCH --job-name={job_name}
#SBATCH --partition={partition}
#SBATCH --nodes=1
#SBATCH --ntasks={ncpu}
#SBATCH --cpus-per-task=1
#SBATCH --mem={memory}
#SBATCH --time={time_limit}
#SBATCH --output={log_path}
#SBATCH --error={log_path}
"""

        if scratch_enabled:
            pregenerated_copy = ""
            if batch_koomesh and pregenerated_dir:
                pregenerated_copy = f"""
# Pre-generated DropSet.k 복사
PREGENERATED_DIR=$SCRATCH_DIR/pregenerated
mkdir -p $PREGENERATED_DIR
cp -r {pregenerated_dir}/Run_{doe_idx} $PREGENERATED_DIR/
echo "Pre-generated 파일 복사 완료: $PREGENERATED_DIR"
"""
                run_cmd_resolved = f"{kcr_path} run $SCRATCH_DIR/runner_config.json --doe {doe_idx} --skip-koomeshmodifier --pregenerated-dir $PREGENERATED_DIR"
            else:
                run_cmd_resolved = f"{kcr_path} run $SCRATCH_DIR/runner_config.json --doe {doe_idx}"

            script_content = sbatch_header + f"""{apptainer_tmpdir_line}

echo "========================================"
echo "Job: {job_name} (scratch mode)"
echo "DOE: {doe_idx}/{doe_count}"
echo "Node: $(hostname)"
echo "Start: $(date)"
echo "========================================"

# ---- Scratch 설정 ----
SCRATCH_DIR={scratch_base}/$SLURM_JOB_ID/DOE_{doe_idx:03d}
ORIG_OUTPUT_DIR={output_dir}
EXIT_CODE=1

mkdir -p $SCRATCH_DIR
echo "Scratch 디렉토리: $SCRATCH_DIR"

# 모델 파일 복사
cp {model_file} $SCRATCH_DIR/
cp {model_dir}/*.k $SCRATCH_DIR/ 2>/dev/null || true
echo "모델 파일 복사 완료"
{pregenerated_copy}
# runner_config.json 경로 치환하여 scratch에 복사
python3 -c "
import json
with open('{config_path}') as f:
    cfg = json.load(f)
cfg['project']['output_dir'] = '$SCRATCH_DIR/output'
cfg['project']['index_file'] = '$SCRATCH_DIR/output/simulation_index.json'
cfg['project']['model_file'] = '$SCRATCH_DIR/{model_basename}'
cfg['execution']['checkpoint_file'] = '$SCRATCH_DIR/output/checkpoint.json'
import os
os.makedirs('$SCRATCH_DIR/output', exist_ok=True)
with open('$SCRATCH_DIR/runner_config.json', 'w') as f:
    json.dump(cfg, f, indent=2)
"
echo "Runner config 생성 완료: $SCRATCH_DIR/runner_config.json"

# ---- EXIT trap: 결과 복사 (성공/실패 모두) ----
cleanup() {{
    echo ""
    echo "========================================"
    echo "결과 복사: scratch → 원본 위치"
    echo "========================================"

    # Run_ 폴더 복사
    if ls $SCRATCH_DIR/output/Run_* 1>/dev/null 2>&1; then
        mkdir -p $ORIG_OUTPUT_DIR
        rsync -a $SCRATCH_DIR/output/Run_*/ $ORIG_OUTPUT_DIR/ 2>/dev/null || \\
