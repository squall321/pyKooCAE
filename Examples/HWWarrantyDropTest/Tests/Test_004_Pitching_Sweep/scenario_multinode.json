{
  "project_name": "Test_004_Pitching_Sweep",
  "environment": {
    "koomeshmodifier_path": "/opt/KooMeshModifier/run.sh",
    "lsdyna_path": "/opt/ls-dyna/lsdyna_R16.1.1",
    "mpi_path": "/shared/intel-mpi/bin/mpirun",
    "mpi_launcher": "srun",
    "lsdyna_memory": "2000m",
    "nodes_per_job": 2,
    "apptainer_sif": "/opt/apptainers/KooSimulation313.sif",
    "apptainer_bind": "/data:/data",
    "apptainer_env": {},
    "lsdyna_apptainer_sif": "/opt/apptainers/LSDynaBasic_ifort2022_impilatest_mpp_s.sif",
    "lsdyna_apptainer_bind": "/data:/data",
    "lsdyna_apptainer_env": {
      "LSTC_FILE": "/opt/ls-dyna_license/LSTC_FILE",
      "FI_PROVIDER": "tcp",
      "I_MPI_FABRICS": "ofi"
    },
    "koochainrun_path": "/opt/pyKooCAE/KooChainRun"
  },
  "scenarios": [
    {
      "scenario_name": "Pitching_Sweep_40deg_1deg_Step",
      "template": "MinimumModel.k",
      "angle_source": {
        "source_type": "pitching_sweep",
        "pitching_sweep": {
          "pitch_start": -40,
          "pitch_end": 40,
          "pitch_step": 1,
          "roll": 0,
          "yaw": 0
        }
      },
      "cumulative": {
        "num_steps": 1,
        "mode_sequence": [
          "DROP"
        ],
        "base_angle_index": 0,
        "angle_mixing": {
          "strategy": "same_angle"
        }
      }
    }
  ]
}
